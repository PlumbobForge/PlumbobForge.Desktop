<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icon="using:IconPacks.Avalonia.BoxIcons"
             xmlns:vm="using:PlumbobForge.Desktop.ViewModels"
             xmlns:views="using:PlumbobForge.Desktop.Views"
             xmlns:modals="using:PlumbobForge.Desktop.Views.Modals"
             x:Class="PlumbobForge.Desktop.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PlumbobForge.Desktop/Styles/Colors.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <DataTemplate DataType="{x:Type vm:TaskProgressModalViewModel}">
            <modals:TaskProgressModalView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ContentManagerViewModel}">
            <views:ContentManagerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfigurationsViewModel}">
            <views:ConfigurationsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HealthViewModel}">
            <views:HealthView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://IconPacks.Avalonia.BoxIcons/BoxIcons.axaml" />
        <StyleInclude Source="avares://PlumbobForge.Desktop/Styles/Controls.axaml" />

        <!-- Fully Custom ScrollBar Control Template -->
        <Style Selector="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid x:Name="RootGrid" Background="Transparent">
                        <Track x:Name="PART_Track"
                                Minimum="{TemplateBinding Minimum}"
                                Maximum="{TemplateBinding Maximum}"
                                Value="{TemplateBinding Value, Mode=TwoWay}"
                                ViewportSize="{TemplateBinding ViewportSize}"
                                Orientation="{TemplateBinding Orientation}">
                            <Track.DecreaseButton>
                                <RepeatButton Background="Transparent" BorderThickness="0" Padding="0" Focusable="False" IsTabStop="False" FocusAdorner="{x:Null}"/>
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Background="Transparent" BorderThickness="0" Padding="0" Focusable="False" IsTabStop="False" FocusAdorner="{x:Null}"/>
                            </Track.IncreaseButton>
                            <Track.Thumb>
                                <Thumb x:Name="PART_Thumb" Background="#64748b" CornerRadius="0" Margin="0">
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Container Hover Triggers to Reveal ScrollBar -->
        <Style Selector="ScrollViewer:pointerover ScrollBar">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Border:pointerover ScrollViewer ScrollBar">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Grid:pointerover ScrollViewer ScrollBar">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- Vertical & Horizontal Dimensions -->
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="6"/>
            <Setter Property="MinHeight" Value="6"/>
        </Style>

        <!-- Thumb Hover & Pressed States: Dynamic Accent -->
        <Style Selector="ScrollBar /template/ Thumb#PART_Thumb:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="ScrollBar:pointerover /template/ Thumb#PART_Thumb">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="ScrollBar /template/ Thumb#PART_Thumb:pressed">
            <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
        </Style>

        <!-- Global Custom PopupRoot, FlyoutPresenter, ContextMenu, MenuFlyoutPresenter with Acrylic Frosted Glass -->
        <Style Selector="PopupRoot">
            <Setter Property="TransparencyLevelHint" Value="AcrylicBlur, Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="FlyoutPresenter">
            <Setter Property="Background" Value="{DynamicResource BgSidebar}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style Selector="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource BgSidebar}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="6"/>
        </Style>

        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Background" Value="{DynamicResource BgSidebar}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="6"/>
        </Style>

        <!-- Global MenuItem Styling -->
        <Style Selector="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>

        <Style Selector="MenuItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgCardAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        </Style>
        <Style Selector="MenuItem:pointerover icon|PackIconBoxIcons">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="MenuItem icon|PackIconBoxIcons">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>

        <!-- Global ContextMenu / MenuFlyout Separator Styling matching border -->
        <Style Selector="ContextMenu Separator, MenuFlyoutPresenter Separator">
            <Setter Property="Background" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="4,4"/>
        </Style>

        <!-- Global CheckBox Styling with Dynamic Accent -->
        <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="CheckBox:checked:pointerover /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>
        <Style Selector="CheckBox:checked:pressed /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}"/>
        </Style>
        <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
            <Setter Property="Fill" Value="#ffffff"/>
            <Setter Property="Stroke" Value="#ffffff"/>
        </Style>
        <Style Selector="CheckBox:indeterminate /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!-- Global RadioButton Styling with Dynamic Accent -->
        <Style Selector="RadioButton /template/ Ellipse#OuterEllipse">
            <Setter Property="Stroke" Value="{DynamicResource TextSubtle}"/>
            <Setter Property="Fill" Value="Transparent"/>
        </Style>
        <Style Selector="RadioButton:checked /template/ Ellipse#CheckOuterEllipse">
            <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="RadioButton:checked /template/ Ellipse#CheckGlyph">
            <Setter Property="Fill" Value="#ffffff"/>
            <Setter Property="Stroke" Value="#ffffff"/>
        </Style>
        <Style Selector="RadioButton:checked:pointerover /template/ Ellipse#CheckOuterEllipse">
            <Setter Property="Fill" Value="{DynamicResource AccentHoverBrush}"/>
            <Setter Property="Stroke" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>
        <Style Selector="RadioButton:checked:pressed /template/ Ellipse#CheckOuterEllipse">
            <Setter Property="Fill" Value="{DynamicResource AccentPressedBrush}"/>
            <Setter Property="Stroke" Value="{DynamicResource AccentPressedBrush}"/>
        </Style>
    </Application.Styles>
</Application>
