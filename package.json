{
  "name": "plumbobforge-app",
  "private": true,
  "version": "0.2.2",
  "description": "CC Manager for The Sims 3",
  "author": "bringscookies",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview"
  },
  "build": {
    "files": [
      "dist",
      "dist-electron"
    ],
    "directories": {
      "output": "../release"
    },
    "appId": "com.plumbobforge.app",
    "productName": "PlumbobForge",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "PlumbobForge",
        "repo": "PlumbobForgeApp"
      }
    ],
    "win": {
      "icon": "../appicon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PlumbobForge"
    },
    "extraResources": [
      {
        "from": "dist-backend",
        "to": "dist-backend"
      }
    ]
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "electron-updater": "^6.8.9",
    "material-symbols": "^0.45.9",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  }
}
