<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PlumbobForge.Desktop.ViewModels"
        xmlns:icon="using:IconPacks.Avalonia.BoxIcons"
        xmlns:loc="using:PlumbobForge.Desktop.MarkupExtensions"
        x:Class="PlumbobForge.Desktop.Views.Dialogs.NewUserWalkthroughWindow"
        x:DataType="vm:NewUserWalkthroughViewModel"
        Title="{loc:Loc 'dialogs.walkthrough.title'}"
        Width="900" Height="620"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource BgSidebar}">

    <!--
        Page changes and entrance animations are driven from code-behind (ShowStep): controls marked "reveal" fade up
        one after another, controls marked "pop" scale in. Only the looping animations below are style-based.
    -->
    <Window.Styles>
        <Style Selector="Image.float">
            <Style.Animations>
                <Animation Duration="0:0:3.6" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="0"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="TranslateTransform.Y" Value="-7"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="icon|PackIconBoxIcons.spinner">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ===== Typography ===== -->
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.page-desc">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="19"/>
        </Style>
        <Style Selector="TextBlock.feat-title">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.feat-desc">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="16"/>
        </Style>
        <Style Selector="TextBlock.form-label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        </Style>

        <!-- ===== Step rail ===== -->
        <!--
            Highlights fade with Opacity over solid layers, never with a BrushTransition from Transparent:
            Transparent is transparent white, so tweening it towards a dark brush flashes light grey.
        -->
        <Style Selector="Button.rail-step">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.rail-step /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.rail-step:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.rail-step:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.rail-step:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.rail-highlight">
            <Setter Property="Background" Value="{DynamicResource BgCardAlt}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.rail-step:pointerover Border.rail-highlight">
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
        <Style Selector="Button.rail-step.active Border.rail-highlight">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.rail-step:disabled Border.rail-highlight">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Button.rail-step TextBlock.rail-title">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>
        <Style Selector="Button.rail-step.active TextBlock.rail-title">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.rail-step:disabled TextBlock.rail-title">
            <Setter Property="Foreground" Value="{DynamicResource TextSubtle}"/>
        </Style>

        <Style Selector="Panel.rail-dot">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
        </Style>
        <Style Selector="Panel.rail-dot > Ellipse">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Ellipse.dot-ring">
            <Setter Property="Stroke" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
        </Style>
        <Style Selector="Ellipse.dot-done">
            <Setter Property="Fill" Value="{DynamicResource AccentBadgeBgBrush}"/>
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Ellipse.dot-active">
            <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Panel.rail-dot.done Ellipse.dot-ring, Panel.rail-dot.active Ellipse.dot-ring">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Panel.rail-dot.done Ellipse.dot-done">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Panel.rail-dot.active Ellipse.dot-active">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Panel.rail-dot TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>
        <Style Selector="Panel.rail-dot.active TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Panel.rail-dot icon|PackIconBoxIcons">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style Selector="Button.link-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.link-btn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.link-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!-- ===== Selectable choice cards (storage mode, import source) ===== -->
        <Style Selector="Button.choice-card">
            <Setter Property="Background" Value="{DynamicResource BgSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMain}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.choice-card /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{TemplateBinding Background}"/>
            <Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}"/>
        </Style>
        <Style Selector="Button.choice-card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgCardAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderActive}"/>
        </Style>
        <Style Selector="Button.choice-card:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgCardAlt}"/>
        </Style>
        <Style Selector="Button.choice-card.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BgCardAlt}"/>
        </Style>
        <Style Selector="Button.choice-card.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style Selector="Border.radio-dot">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.choice-card.selected Border.radio-dot">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Border.radio-dot icon|PackIconBoxIcons">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Button.choice-card.selected Border.radio-dot icon|PackIconBoxIcons">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <!-- ===== Small reusable bits ===== -->
        <Style Selector="Border.icon-tile">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <!-- Mock-ups of the app's tabs -->
        <Style Selector="Border.mock">
            <Setter Property="Background" Value="{DynamicResource BgDark}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMain}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <Style Selector="Border.mock-panel">
            <Setter Property="Background" Value="{DynamicResource BgSidebar}"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style Selector="Border.mock-search">
            <Setter Property="Background" Value="{DynamicResource BgDark}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Padding" Value="7,0"/>
        </Style>
        <Style Selector="Border.mock-tab">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="7,3"/>
        </Style>
        <Style Selector="Border.mock-tab.active">
            <Setter Property="Background" Value="{DynamicResource AccentBadgeBgBrush}"/>
        </Style>
        <Style Selector="Border.mock-tab TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.mock-tab.active TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Border.mock-tab icon|PackIconBoxIcons">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.mock-tab.active icon|PackIconBoxIcons">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="TextBlock.mock-heading">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.mock-text">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.mock-label">
            <Setter Property="FontSize" Value="7.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="0.6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>
        <Style Selector="Border.mock-chip">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,3,3"/>
        </Style>
        <Style Selector="Border.mock-chip TextBlock">
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Border.mock-count">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.mock-count TextBlock">
            <Setter Property="FontSize" Value="7.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>
        <Style Selector="Border.mock-row">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMain}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BgDark}"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="Border.mock-tile">
            <Setter Property="Background" Value="{DynamicResource BgCardAlt}"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
        <Style Selector="Border.mock-tile icon|PackIconBoxIcons">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.mock-btn">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource BgSidebar}"/>
        </Style>
        <Style Selector="Border.mock-btn icon|PackIconBoxIcons">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.bar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Background" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.mini-toggle">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="11"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource BorderSubtle}"/>
        </Style>
        <Style Selector="Border.mini-toggle.on">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Border.mini-toggle > Ellipse">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="Fill" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="Border.mini-toggle.on > Ellipse">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- Accent swatches -->
        <Style Selector="Button.swatch-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.swatch-btn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.swatch-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.swatch-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Styles>

    <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource BgSidebar}">
        <Grid ColumnDefinitions="220, *">

            <!-- ================= LEFT: STEP RAIL ================= -->
            <Border Grid.Column="0" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderMain}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto, *, Auto">
                    <Border Grid.Row="0" Height="34" Background="Transparent" PointerPressed="OnHeaderPointerPressed"/>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Steps}" Margin="12,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:WalkthroughStepItemViewModel">
                                <Button Classes="rail-step"
                                        Classes.active="{Binding IsActive}"
                                        IsEnabled="{Binding IsReachable}"
                                        Click="OnStepClick">
                                    <Panel>
                                        <Border Classes="rail-highlight"/>
                                        <Grid ColumnDefinitions="Auto, *" Margin="8,6">
                                            <Panel Grid.Column="0" Classes="rail-dot" Classes.done="{Binding IsDone}" Classes.active="{Binding IsActive}">
                                                <Ellipse Classes="dot-ring"/>
                                                <Ellipse Classes="dot-done"/>
                                                <Ellipse Classes="dot-active"/>
                                                <TextBlock Text="{Binding Number}" FontSize="11" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           IsVisible="{Binding IsPending}"/>
                                                <icon:PackIconBoxIcons Kind="RegularCheck" Width="13" Height="13"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       IsVisible="{Binding IsDone}"/>
                                            </Panel>
                                            <TextBlock Grid.Column="1" Classes="rail-title" Text="{Binding Title}"
                                                       Margin="11,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Panel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Grid.Row="2" Classes="link-btn" HorizontalAlignment="Left" Margin="14,0,0,18"
                            Content="{loc:Loc 'dialogs.walkthrough.skip_tour'}"
                            Command="{Binding SkipTourCommand}" IsVisible="{Binding CanSkipTour}"/>
                </Grid>
            </Border>

            <!-- ================= RIGHT: PAGES ================= -->
            <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto">
                <Border Grid.Row="0" Height="26" Background="Transparent" PointerPressed="OnHeaderPointerPressed"/>

                <Panel Grid.Row="1" x:Name="PageHost" Margin="44,4,44,0">

                    <!-- ========== 1. WELCOME ========== -->
                    <StackPanel VerticalAlignment="Center" Spacing="22" Margin="0,0,0,24">
                        <Panel Classes="reveal" HorizontalAlignment="Center">
                            <Image Classes="float" Source="{SvgImage /Assets/appicon.svg}" Width="124" Height="124"/>
                        </Panel>

                        <StackPanel Classes="reveal" Spacing="8" HorizontalAlignment="Center" MaxWidth="500">
                            <TextBlock Text="{loc:Loc 'dialogs.walkthrough.welcome_hero'}" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Text="{loc:Loc 'dialogs.walkthrough.welcome_sub'}" Classes="page-desc" FontSize="13.5" TextAlignment="Center" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Classes="reveal" Orientation="Horizontal" Spacing="26" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <icon:PackIconBoxIcons Kind="RegularBolt" Width="15" Height="15" Foreground="{DynamicResource StatusAmber}" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc 'dialogs.walkthrough.chip_speed'}" FontSize="12.5" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <icon:PackIconBoxIcons Kind="RegularFolder" Width="15" Height="15" Foreground="{DynamicResource StatusCyan}" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc 'dialogs.walkthrough.chip_sets'}" FontSize="12.5" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <icon:PackIconBoxIcons Kind="RegularSliderAlt" Width="15" Height="15" Foreground="{DynamicResource StatusPurple}" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc 'dialogs.walkthrough.chip_profiles'}" FontSize="12.5" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Language -->
                        <StackPanel Classes="reveal" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <icon:PackIconBoxIcons Kind="RegularGlobe" Width="15" Height="15" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource BgSurface}" CornerRadius="8" Padding="3">
                                <ItemsControl ItemsSource="{Binding LanguageChoices}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:WalkthroughLanguageOptionViewModel">
                                            <Button Classes="segment-btn" Classes.active="{Binding IsSelected}" Padding="14,5" FontSize="12"
                                                    Content="{Binding Label}" Click="OnLanguageClick"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- ========== 2. LIBRARY TAB ========== -->
                    <StackPanel Spacing="18" VerticalAlignment="Top" Margin="0,8,0,0">
                        <StackPanel Classes="reveal" Spacing="6">
                            <TextBlock Classes="page-title" Text="{loc:Loc 'dialogs.walkthrough.library_title'}"/>
                            <TextBlock Classes="page-desc" Text="{loc:Loc 'dialogs.walkthrough.library_desc'}"/>
                        </StackPanel>

                        <!-- Mock-up of the Library tab: sets on the left, items in the middle, filters on the right -->
                        <Border Classes="mock reveal" Height="214">
                            <Grid RowDefinitions="Auto, *">
                                <Border Grid.Row="0" Background="{DynamicResource BgSidebar}" Padding="6,0" Height="28">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                            <Border Classes="mock-tab active"><StackPanel Orientation="Horizontal" Spacing="4"><icon:PackIconBoxIcons Kind="RegularFolder"/><TextBlock Text="{loc:Loc nav.library}"/></StackPanel></Border>
                                            <Border Classes="mock-tab"><StackPanel Orientation="Horizontal" Spacing="4"><icon:PackIconBoxIcons Kind="RegularSliderAlt"/><TextBlock Text="{loc:Loc nav.configurations}"/></StackPanel></Border>
                                            <Border Classes="mock-tab"><StackPanel Orientation="Horizontal" Spacing="4"><icon:PackIconBoxIcons Kind="RegularSpanner"/><TextBlock Text="{loc:Loc nav.tools}"/></StackPanel></Border>
                                            <Border Classes="mock-tab"><StackPanel Orientation="Horizontal" Spacing="4"><icon:PackIconBoxIcons Kind="RegularCog"/><TextBlock Text="{loc:Loc nav.settings}"/></StackPanel></Border>
                                        </StackPanel>
                                        <Border Grid.Column="1" Classes="mock-tab"><StackPanel Orientation="Horizontal" Spacing="4"><icon:PackIconBoxIcons Kind="RegularSearch"/><TextBlock Text="{loc:Loc nav.quick_jump}"/></StackPanel></Border>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="1" ColumnDefinitions="118, *, 150" Margin="7">
                                    <!-- Sets -->
                                    <Border Grid.Column="0" Classes="mock-panel">
                                        <StackPanel Spacing="7">
                                            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,2">
                                                <TextBlock Classes="mock-heading" Text="{loc:Loc library.sets}"/>
                                                <Border Grid.Column="1" Width="14" Height="14" CornerRadius="4" Background="{DynamicResource AccentBrush}">
                                                    <icon:PackIconBoxIcons Kind="RegularPlus" Width="9" Height="9" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto, *, Auto">
                                                <icon:PackIconBoxIcons Kind="RegularLayers" Width="10" Height="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Classes="mock-text" Text="{loc:Loc library.all_items}" Margin="5,0,0,0" TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="2" Classes="mock-count"><TextBlock Text="214"/></Border>
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto, *, Auto">
                                                <icon:PackIconBoxIcons Kind="SolidStar" Width="10" Height="10" Foreground="{DynamicResource StatusAmber}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Classes="mock-text" Text="{loc:Loc library.favorites}" Margin="5,0,0,0" TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="2" Classes="mock-count"><TextBlock Text="12"/></Border>
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto, *, Auto">
                                                <icon:PackIconBoxIcons Kind="RegularFolder" Width="10" Height="10" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Classes="bar" Width="38" Margin="5,0,0,0"/>
                                                <Border Grid.Column="2" Classes="mock-count"><TextBlock Text="96"/></Border>
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto, *, Auto" Margin="9,0,0,0">
                                                <icon:PackIconBoxIcons Kind="RegularFolder" Width="10" Height="10" Foreground="{DynamicResource StatusPurple}" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Classes="bar" Width="30" Margin="5,0,0,0"/>
                                                <Border Grid.Column="2" Classes="mock-count"><TextBlock Text="41"/></Border>
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto, *, Auto">
                                                <icon:PackIconBoxIcons Kind="RegularFolder" Width="10" Height="10" Foreground="{DynamicResource StatusCyan}" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Classes="bar" Width="44" Margin="5,0,0,0"/>
                                                <Border Grid.Column="2" Classes="mock-count"><TextBlock Text="77"/></Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Items -->
                                    <Grid Grid.Column="1" RowDefinitions="Auto, *" Margin="7,0">
                                        <Border Grid.Row="0" HorizontalAlignment="Right" Background="{DynamicResource BgSidebar}" CornerRadius="6" Padding="6,3" Margin="0,0,3,4">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <icon:PackIconBoxIcons Kind="RegularSearch" Width="9" Height="9" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                                <Grid Width="40" VerticalAlignment="Center">
                                                    <Border Height="2" CornerRadius="1" Background="{DynamicResource BorderSubtle}"/>
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                                </Grid>
                                                <icon:PackIconBoxIcons Kind="RegularGrid" Width="10" Height="10" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                <icon:PackIconBoxIcons Kind="RegularListUl" Width="10" Height="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <UniformGrid Grid.Row="1" Columns="4" Rows="3">
                                            <Border Classes="mock-tile pop"><icon:PackIconBoxIcons Kind="RegularTShirt" Foreground="{DynamicResource StatusPurple}"/></Border>
                                            <Border Classes="mock-tile pop"><icon:PackIconBoxIcons Kind="RegularFace" Foreground="{DynamicResource StatusAmber}"/></Border>
                                            <Border Classes="mock-tile pop"><icon:PackIconBoxIcons Kind="RegularChair" Foreground="{DynamicResource StatusCyan}"/></Border>
                                            <Border Classes="mock-tile pop"><icon:PackIconBoxIcons Kind="RegularBed" Foreground="{DynamicResource AccentBrush}"/></Border>
                                            <Border Classes="mock-tile pop"><icon:PackIconBoxIcons Kind="RegularBrush" Foreground="{DynamicResource StatusRed}"/></Border>
                                            <Border Classes="mock-tile pop"><icon:PackIconBoxIcons Kind="RegularDiamond" Foreground="{DynamicResource StatusBlue}"/></Border>
                                            <Border Classes="mock-tile pop"><icon:PackIconBoxIcons Kind="RegularLeaf" Foreground="{DynamicResource StatusGreen}"/></Border>
                                            <Border Classes="mock-tile pop"><icon:PackIconBoxIcons Kind="RegularDish" Foreground="{DynamicResource StatusAmber}"/></Border>
                                            <Border Classes="mock-tile pop"><icon:PackIconBoxIcons Kind="RegularMusic" Foreground="{DynamicResource StatusPurple}"/></Border>
                                            <Border Classes="mock-tile pop"><icon:PackIconBoxIcons Kind="RegularCar" Foreground="{DynamicResource StatusCyan}"/></Border>
                                            <Border Classes="mock-tile pop"><icon:PackIconBoxIcons Kind="RegularHome" Foreground="{DynamicResource AccentBrush}"/></Border>
                                            <Border Classes="mock-tile pop"><icon:PackIconBoxIcons Kind="RegularStar" Foreground="{DynamicResource StatusRed}"/></Border>
                                        </UniformGrid>
                                    </Grid>

                                    <!-- Filters -->
                                    <Border Grid.Column="2" Classes="mock-panel">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,0,1">
                                                <icon:PackIconBoxIcons Kind="RegularArrowToRightStroke" Width="10" Height="10" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                                                <TextBlock Classes="mock-heading" Text="{loc:Loc filters.title}"/>
                                            </StackPanel>
                                            <Border Classes="mock-search">
                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                    <icon:PackIconBoxIcons Kind="RegularSearch" Width="8" Height="8" Foreground="{DynamicResource TextMuted}"/>
                                                    <Border Classes="bar" Width="56" Height="4"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Classes="mock-label" Text="{loc:Loc filters.type}"/>
                                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="5" Padding="7,4">
                                                <TextBlock Text="{loc:Loc filters.cas_items}" FontSize="8.5" FontWeight="SemiBold" Foreground="White"/>
                                            </Border>
                                            <TextBlock Classes="mock-label" Text="{loc:Loc filters.category}"/>
                                            <WrapPanel>
                                                <Border Classes="mock-chip"><TextBlock Text="{loc:Loc filters.cas.hair}"/></Border>
                                                <Border Classes="mock-chip"><TextBlock Text="{loc:Loc filters.cas.tops}"/></Border>
                                                <Border Classes="mock-chip"><TextBlock Text="{loc:Loc filters.cas.shoes}"/></Border>
                                                <Border Classes="mock-chip"><TextBlock Text="{loc:Loc filters.cas.skins}"/></Border>
                                                <Border Classes="mock-chip"><TextBlock Text="{loc:Loc filters.cas.accessories}"/></Border>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <UniformGrid Classes="reveal" Columns="3">
                            <StackPanel Spacing="5" Margin="0,0,14,0">
                                <icon:PackIconBoxIcons Kind="RegularFolder" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Classes="feat-title" Text="{loc:Loc 'dialogs.walkthrough.library_f1_title'}"/>
                                <TextBlock Classes="feat-desc" Text="{loc:Loc 'dialogs.walkthrough.library_f1_desc'}"/>
                            </StackPanel>
                            <StackPanel Spacing="5" Margin="0,0,14,0">
                                <icon:PackIconBoxIcons Kind="RegularSearch" Width="18" Height="18" Foreground="{DynamicResource StatusCyan}"/>
                                <TextBlock Classes="feat-title" Text="{loc:Loc 'dialogs.walkthrough.library_f2_title'}"/>
                                <TextBlock Classes="feat-desc" Text="{loc:Loc 'dialogs.walkthrough.library_f2_desc'}"/>
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <icon:PackIconBoxIcons Kind="RegularImageAlt" Width="18" Height="18" Foreground="{DynamicResource StatusPurple}"/>
                                <TextBlock Classes="feat-title" Text="{loc:Loc 'dialogs.walkthrough.library_f3_title'}"/>
                                <TextBlock Classes="feat-desc" Text="{loc:Loc 'dialogs.walkthrough.library_f3_desc'}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>

                    <!-- ========== 3. CONFIGURATIONS TAB ========== -->
                    <StackPanel Spacing="18" VerticalAlignment="Top" Margin="0,8,0,0">
                        <StackPanel Classes="reveal" Spacing="6">
                            <TextBlock Classes="page-title" Text="{loc:Loc 'dialogs.walkthrough.configs_title'}"/>
                            <TextBlock Classes="page-desc" Text="{loc:Loc 'dialogs.walkthrough.configs_desc'}"/>
                        </StackPanel>

                        <!-- Mock-up of the Configurations tab: configuration list on the left, enabled/disabled sets on the right -->
                        <Border Classes="mock reveal" Height="214">
                            <Grid RowDefinitions="Auto, *">
                                <Border Grid.Row="0" Background="{DynamicResource BgSidebar}" Padding="6,0" Height="28">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                            <Border Classes="mock-tab"><StackPanel Orientation="Horizontal" Spacing="4"><icon:PackIconBoxIcons Kind="RegularFolder"/><TextBlock Text="{loc:Loc nav.library}"/></StackPanel></Border>
                                            <Border Classes="mock-tab active"><StackPanel Orientation="Horizontal" Spacing="4"><icon:PackIconBoxIcons Kind="RegularSliderAlt"/><TextBlock Text="{loc:Loc nav.configurations}"/></StackPanel></Border>
                                            <Border Classes="mock-tab"><StackPanel Orientation="Horizontal" Spacing="4"><icon:PackIconBoxIcons Kind="RegularSpanner"/><TextBlock Text="{loc:Loc nav.tools}"/></StackPanel></Border>
                                            <Border Classes="mock-tab"><StackPanel Orientation="Horizontal" Spacing="4"><icon:PackIconBoxIcons Kind="RegularCog"/><TextBlock Text="{loc:Loc nav.settings}"/></StackPanel></Border>
                                        </StackPanel>
                                        <Border Grid.Column="1" Classes="mock-tab"><StackPanel Orientation="Horizontal" Spacing="4"><icon:PackIconBoxIcons Kind="RegularSearch"/><TextBlock Text="{loc:Loc nav.quick_jump}"/></StackPanel></Border>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="1" ColumnDefinitions="128, *" Margin="7">
                                    <!-- Configuration list -->
                                    <Border Grid.Column="0" Classes="mock-panel" Margin="0,0,7,0">
                                        <StackPanel Spacing="5">
                                            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,3">
                                                <TextBlock Classes="mock-heading" Text="{loc:Loc configurations.title}" TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="1" Width="14" Height="14" CornerRadius="4" Background="{DynamicResource AccentBrush}">
                                                    <icon:PackIconBoxIcons Kind="RegularPlus" Width="9" Height="9" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                            <Border Classes="pop" Background="{DynamicResource AccentBadgeBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="5" Padding="6,5">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <icon:PackIconBoxIcons Kind="RegularSliderAlt" Width="10" Height="10" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Classes="bar" Width="30" Margin="5,0,0,0" Background="{DynamicResource TextMain}" Opacity="0.6"/>
                                                    <Border Grid.Column="2" Background="{DynamicResource AccentBrush}" CornerRadius="3" Padding="3,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{loc:Loc 'configurations.active_badge'}" FontSize="6.5" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Border Classes="pop" CornerRadius="5" Padding="6,5" BorderThickness="1" BorderBrush="Transparent">
                                                <Grid ColumnDefinitions="Auto, *">
                                                    <icon:PackIconBoxIcons Kind="RegularCrown" Width="10" Height="10" Foreground="{DynamicResource StatusPurple}" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Classes="bar" Width="44" Margin="5,0,0,0"/>
                                                </Grid>
                                            </Border>
                                            <Border Classes="pop" CornerRadius="5" Padding="6,5" BorderThickness="1" BorderBrush="Transparent">
                                                <Grid ColumnDefinitions="Auto, *">
                                                    <icon:PackIconBoxIcons Kind="RegularPlanet" Width="10" Height="10" Foreground="{DynamicResource StatusCyan}" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Classes="bar" Width="34" Margin="5,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Selected configuration -->
                                    <Grid Grid.Column="1" RowDefinitions="Auto, *">
                                        <Border Grid.Row="0" Classes="mock-panel" Margin="0,0,0,7" Padding="9,7">
                                            <StackPanel Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <icon:PackIconBoxIcons Kind="RegularSliderAlt" Width="11" Height="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                    <Border Classes="bar" Width="50" Height="6" Background="{DynamicResource TextMain}" Opacity="0.7"/>
                                                </StackPanel>
                                                <Border Classes="bar" Width="90" Height="4"/>
                                            </StackPanel>
                                        </Border>
                                        <Grid Grid.Row="1" ColumnDefinitions="*, Auto, *">
                                            <Border Grid.Column="0" Classes="mock-panel">
                                                <StackPanel Spacing="5">
                                                    <TextBlock Classes="mock-heading" FontSize="9" Text="{loc:Loc configurations.enabled_sets}"/>
                                                    <Border Classes="mock-search" Margin="0,0,0,2">
                                                        <icon:PackIconBoxIcons Kind="RegularSearch" Width="8" Height="8" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                    </Border>
                                                    <Border Classes="mock-row pop"><StackPanel Orientation="Horizontal" Spacing="5"><icon:PackIconBoxIcons Kind="RegularFolder" Width="10" Height="10" Foreground="{DynamicResource AccentBrush}"/><Border Classes="bar" Width="34"/></StackPanel></Border>
                                                    <Border Classes="mock-row pop"><StackPanel Orientation="Horizontal" Spacing="5"><icon:PackIconBoxIcons Kind="RegularFolder" Width="10" Height="10" Foreground="{DynamicResource StatusPurple}"/><Border Classes="bar" Width="26"/></StackPanel></Border>
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" Margin="5,0">
                                                <Border Classes="mock-btn"><icon:PackIconBoxIcons Kind="RegularChevronRight"/></Border>
                                                <Border Classes="mock-btn"><icon:PackIconBoxIcons Kind="RegularSwapHorizontal"/></Border>
                                                <Border Classes="mock-btn"><icon:PackIconBoxIcons Kind="RegularChevronLeft"/></Border>
                                            </StackPanel>
                                            <Border Grid.Column="2" Classes="mock-panel">
                                                <StackPanel Spacing="5">
                                                    <TextBlock Classes="mock-heading" FontSize="9" Text="{loc:Loc configurations.disabled_sets}"/>
                                                    <Border Classes="mock-search" Margin="0,0,0,2">
                                                        <icon:PackIconBoxIcons Kind="RegularSearch" Width="8" Height="8" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                    </Border>
                                                    <Border Classes="mock-row pop"><StackPanel Orientation="Horizontal" Spacing="5"><icon:PackIconBoxIcons Kind="RegularFolder" Width="10" Height="10" Foreground="{DynamicResource StatusCyan}"/><Border Classes="bar" Width="40"/></StackPanel></Border>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <UniformGrid Classes="reveal" Columns="3">
                            <StackPanel Spacing="5" Margin="0,0,14,0">
                                <icon:PackIconBoxIcons Kind="RegularUserCircle" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Classes="feat-title" Text="{loc:Loc 'dialogs.walkthrough.configs_f1_title'}"/>
                                <TextBlock Classes="feat-desc" Text="{loc:Loc 'dialogs.walkthrough.configs_f1_desc'}"/>
                            </StackPanel>
                            <StackPanel Spacing="5" Margin="0,0,14,0">
                                <icon:PackIconBoxIcons Kind="RegularCheckSquare" Width="18" Height="18" Foreground="{DynamicResource StatusCyan}"/>
                                <TextBlock Classes="feat-title" Text="{loc:Loc 'dialogs.walkthrough.configs_f2_title'}"/>
                                <TextBlock Classes="feat-desc" Text="{loc:Loc 'dialogs.walkthrough.configs_f2_desc'}"/>
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <icon:PackIconBoxIcons Kind="RegularPlay" Width="18" Height="18" Foreground="{DynamicResource StatusPurple}"/>
                                <TextBlock Classes="feat-title" Text="{loc:Loc 'dialogs.walkthrough.configs_f3_title'}"/>
                                <TextBlock Classes="feat-desc" Text="{loc:Loc 'dialogs.walkthrough.configs_f3_desc'}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>

                    <!-- ========== 4. TOOLS TAB ========== -->
                    <StackPanel Spacing="18" VerticalAlignment="Top" Margin="0,8,0,0">
                        <StackPanel Classes="reveal" Spacing="6">
                            <TextBlock Classes="page-title" Text="{loc:Loc 'dialogs.walkthrough.tools_title'}"/>
                            <TextBlock Classes="page-desc" Text="{loc:Loc 'dialogs.walkthrough.tools_desc'}"/>
                        </StackPanel>

                        <UniformGrid Columns="2">
                            <Border Classes="reveal" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderMain}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,6,6">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Border Classes="icon-tile" Background="{DynamicResource StatusAmberBg}">
                                        <icon:PackIconBoxIcons Kind="RegularTrash" Width="18" Height="18" Foreground="{DynamicResource StatusAmber}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,0,0">
                                        <TextBlock Classes="feat-title" Text="{loc:Loc 'tools.cache.title'}"/>
                                        <TextBlock Classes="feat-desc" Text="{loc:Loc 'tools.cache.subtitle'}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Classes="reveal" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderMain}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="6,0,0,6">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Border Classes="icon-tile" Background="{DynamicResource StatusBlueBg}">
                                        <icon:PackIconBoxIcons Kind="RegularShield" Width="18" Height="18" Foreground="{DynamicResource StatusBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,0,0">
                                        <TextBlock Classes="feat-title" Text="{loc:Loc 'tools.conflicts.title'}"/>
                                        <TextBlock Classes="feat-desc" Text="{loc:Loc 'tools.conflicts.subtitle'}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Classes="reveal" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderMain}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,6,6,0">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Border Classes="icon-tile" Background="{DynamicResource StatusPurpleBg}">
                                        <icon:PackIconBoxIcons Kind="RegularPalette" Width="18" Height="18" Foreground="{DynamicResource StatusPurple}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,0,0">
                                        <TextBlock Classes="feat-title" Text="{loc:Loc 'tools.patterns.title'}"/>
                                        <TextBlock Classes="feat-desc" Text="{loc:Loc 'tools.patterns.subtitle'}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Classes="reveal" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderMain}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="6,6,0,0">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Border Classes="icon-tile" Background="{DynamicResource StatusGreenBg}">
                                        <icon:PackIconBoxIcons Kind="RegularFolder" Width="18" Height="18" Foreground="{DynamicResource StatusGreen}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,0,0">
                                        <TextBlock Classes="feat-title" Text="{loc:Loc 'tools.collections.title'}"/>
                                        <TextBlock Classes="feat-desc" Text="{loc:Loc 'tools.collections.subtitle'}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </UniformGrid>

                        <Grid Classes="reveal" ColumnDefinitions="Auto, *" Margin="2,0,0,0">
                            <icon:PackIconBoxIcons Kind="RegularCog" Width="16" Height="16" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                            <TextBlock Grid.Column="1" Classes="feat-desc" Margin="10,0,0,0" Text="{loc:Loc 'dialogs.walkthrough.tools_settings_hint'}"/>
                        </Grid>
                    </StackPanel>

                    <!-- ========== 5. STORAGE MODE ========== -->
                    <StackPanel Spacing="14" VerticalAlignment="Top" Margin="0,8,0,0">
                        <StackPanel Classes="reveal" Spacing="6">
                            <TextBlock Classes="page-title" Text="{loc:Loc 'dialogs.walkthrough.mode_title'}"/>
                            <TextBlock Classes="page-desc" Text="{loc:Loc 'dialogs.walkthrough.mode_desc'}"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <Button Classes="choice-card reveal" Classes.selected="{Binding IsDynamicMode}"
                                    Command="{Binding SelectModeCommand}" CommandParameter="Dynamic">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <Border Classes="icon-tile" Background="{DynamicResource AccentBadgeBgBrush}">
                                        <icon:PackIconBoxIcons Kind="RegularGrid" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3" Margin="13,0,12,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="feat-title" FontSize="13" Text="{loc:Loc 'dialogs.walkthrough.mode_dynamic_title'}" VerticalAlignment="Center"/>
                                            <Border Background="{DynamicResource AccentBadgeBgBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Loc 'dialogs.walkthrough.badge_recommended'}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Classes="feat-desc" Text="{loc:Loc 'dialogs.walkthrough.mode_dynamic_desc'}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Classes="radio-dot">
                                        <icon:PackIconBoxIcons Kind="RegularCheck" Width="12" Height="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <Button Classes="choice-card reveal" Classes.selected="{Binding IsStaticMode}"
                                    Command="{Binding SelectModeCommand}" CommandParameter="Static">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <Border Classes="icon-tile" Background="{DynamicResource StatusCyanBg}">
                                        <icon:PackIconBoxIcons Kind="RegularPackage" Width="18" Height="18" Foreground="{DynamicResource StatusCyan}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3" Margin="13,0,12,0">
                                        <TextBlock Classes="feat-title" FontSize="13" Text="{loc:Loc 'dialogs.walkthrough.mode_static_title'}"/>
                                        <TextBlock Classes="feat-desc" Text="{loc:Loc 'dialogs.walkthrough.mode_static_desc'}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Classes="radio-dot">
                                        <icon:PackIconBoxIcons Kind="RegularCheck" Width="12" Height="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <Button Classes="choice-card reveal" Classes.selected="{Binding IsVaultMode}"
                                    Command="{Binding SelectModeCommand}" CommandParameter="Vault">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <Border Classes="icon-tile" Background="{DynamicResource StatusPurpleBg}">
                                        <icon:PackIconBoxIcons Kind="RegularLock" Width="18" Height="18" Foreground="{DynamicResource StatusPurple}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3" Margin="13,0,12,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="feat-title" FontSize="13" Text="{loc:Loc 'dialogs.walkthrough.mode_vault_title'}" VerticalAlignment="Center"/>
                                            <Border Background="{DynamicResource StatusAmberBg}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Loc 'settings.vault.beta_badge'}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource StatusAmber}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Classes="feat-desc" Text="{loc:Loc 'dialogs.walkthrough.mode_vault_desc'}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Classes="radio-dot">
                                        <icon:PackIconBoxIcons Kind="RegularCheck" Width="12" Height="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!-- At-a-glance comparison for the selected mode -->
                        <Border Classes="reveal" Background="{DynamicResource BgSurface}" CornerRadius="10" Padding="16,12">
                            <Grid ColumnDefinitions="*, *, *">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <icon:PackIconBoxIcons Kind="RegularDatabase" Width="12" Height="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc 'dialogs.walkthrough.fact_disk'}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>
                                    <TextBlock Classes="feat-title" Text="{loc:Loc 'dialogs.walkthrough.fact_disk_library'}" IsVisible="{Binding !IsVaultMode}"/>
                                    <TextBlock Classes="feat-title" Text="{loc:Loc 'dialogs.walkthrough.fact_disk_vault'}" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsVaultMode}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <icon:PackIconBoxIcons Kind="RegularSliderAlt" Width="12" Height="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc 'dialogs.walkthrough.fact_switch'}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>
                                    <TextBlock Classes="feat-title" Text="{loc:Loc 'dialogs.walkthrough.fact_switch_dynamic'}" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsDynamicMode}"/>
                                    <TextBlock Classes="feat-title" Text="{loc:Loc 'dialogs.walkthrough.fact_switch_static'}" IsVisible="{Binding IsStaticMode}"/>
                                    <TextBlock Classes="feat-title" Text="{loc:Loc 'dialogs.walkthrough.fact_switch_vault'}" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsVaultMode}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <icon:PackIconBoxIcons Kind="RegularInfoCircle" Width="12" Height="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc 'dialogs.walkthrough.fact_status'}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>
                                    <TextBlock Classes="feat-title" Text="{loc:Loc 'dialogs.walkthrough.fact_status_stable'}" IsVisible="{Binding !IsVaultMode}"/>
                                    <TextBlock Classes="feat-title" Text="{loc:Loc 'dialogs.walkthrough.fact_status_experimental'}" Foreground="{DynamicResource StatusAmber}" IsVisible="{Binding IsVaultMode}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Classes="reveal" Orientation="Horizontal" Spacing="7">
                            <icon:PackIconBoxIcons Kind="RegularInfoCircle" Width="13" Height="13" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc 'dialogs.walkthrough.mode_note'}" FontSize="11.5" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ========== 6. IMPORT FROM OTHER MANAGERS ========== -->
                    <StackPanel Spacing="16" VerticalAlignment="Top" Margin="0,8,0,0">
                        <StackPanel Classes="reveal" Spacing="6">
                            <TextBlock Classes="page-title" Text="{loc:Loc 'dialogs.walkthrough.import_title'}"/>
                            <TextBlock Classes="page-desc" Text="{loc:Loc 'dialogs.walkthrough.import_desc'}"/>
                        </StackPanel>

                        <UniformGrid Columns="2" IsVisible="{Binding ShowImportChoices}">
                            <Button Classes="choice-card reveal" Margin="0,0,5,0" Padding="16" Command="{Binding ImportFromCcMagicCommand}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <Border Classes="icon-tile" Background="{DynamicResource StatusPurpleBg}">
                                            <icon:PackIconBoxIcons Kind="RegularMagicWand" Width="18" Height="18" Foreground="{DynamicResource StatusPurple}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <icon:PackIconBoxIcons Grid.Column="2" Kind="RegularChevronRight" Width="16" Height="16" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="feat-title" FontSize="13" Text="{loc:Loc 'dialogs.migration.ccmagic_title'}"/>
                                        <TextBlock Classes="feat-desc" Text="{loc:Loc 'dialogs.migration.ccmagic_desc'}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Classes="choice-card reveal" Margin="5,0,0,0" Padding="16" Command="{Binding ImportFromS3moCommand}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <Border Classes="icon-tile" Background="{DynamicResource StatusCyanBg}">
                                            <icon:PackIconBoxIcons Kind="RegularLayers" Width="18" Height="18" Foreground="{DynamicResource StatusCyan}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <icon:PackIconBoxIcons Grid.Column="2" Kind="RegularChevronRight" Width="16" Height="16" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="feat-title" FontSize="13" Text="{loc:Loc 'dialogs.migration.s3mo_title'}"/>
                                        <TextBlock Classes="feat-desc" Text="{loc:Loc 'dialogs.migration.s3mo_desc'}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <!-- Importing -->
                        <Border Background="{DynamicResource BgSurface}" CornerRadius="10" Padding="22,26" IsVisible="{Binding IsImporting}">
                            <StackPanel Spacing="12" HorizontalAlignment="Center">
                                <icon:PackIconBoxIcons Classes="spinner" Kind="RegularRefreshCw" Width="28" Height="28" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc 'dialogs.walkthrough.importing_title'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding ImportProgressText}" FontSize="11.5" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="460"/>
                                <ProgressBar IsIndeterminate="True" Width="260" Height="4" MinHeight="4" CornerRadius="2" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderMain}"/>
                            </StackPanel>
                        </Border>

                        <!-- Imported -->
                        <Border Background="{DynamicResource AccentBadgeBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14">
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="HasImported"/>
                                    <Binding Path="!ImportFailed"/>
                                </MultiBinding>
                            </Border.IsVisible>
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <icon:PackIconBoxIcons Kind="RegularCheckCircle" Width="22" Height="22" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1" Spacing="3" Margin="12,0">
                                    <TextBlock Text="{loc:Loc 'dialogs.walkthrough.import_complete_badge'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                    <TextBlock Text="{Binding MigrationResultText}" Classes="feat-desc"/>
                                </StackPanel>
                                <Button Grid.Column="2" Classes="btn-action-sec" Command="{Binding RetryImportCommand}" VerticalAlignment="Center"
                                        Content="{loc:Loc 'dialogs.walkthrough.import_another_btn'}"/>
                            </Grid>
                        </Border>

                        <!-- Failed -->
                        <Border Background="{DynamicResource StatusRedBg}" BorderBrush="{DynamicResource StatusRed}" BorderThickness="1" CornerRadius="10" Padding="16,14" IsVisible="{Binding ImportFailed}">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <icon:PackIconBoxIcons Kind="RegularAlertCircle" Width="22" Height="22" Foreground="{DynamicResource StatusRed}" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{Binding MigrationResultText}" Classes="feat-desc" Foreground="{DynamicResource TextMain}" Margin="12,0" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Classes="btn-action-sec" Command="{Binding RetryImportCommand}" VerticalAlignment="Center"
                                        Content="{loc:Loc 'dialogs.walkthrough.import_retry_btn'}"/>
                            </Grid>
                        </Border>

                        <StackPanel Classes="reveal" Spacing="8">
                            <Grid ColumnDefinitions="Auto, *">
                                <icon:PackIconBoxIcons Kind="RegularMove" Width="14" Height="14" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                <TextBlock Grid.Column="1" Text="{loc:Loc 'dialogs.walkthrough.fresh_desc'}" FontSize="11.5" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="8,0,0,0"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto, *" IsVisible="{Binding IsVaultMode}">
                                <icon:PackIconBoxIcons Kind="RegularInfoCircle" Width="14" Height="14" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                <TextBlock Grid.Column="1" Text="{loc:Loc 'dialogs.walkthrough.import_vault_note'}" FontSize="11.5" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <!-- ========== 7. PERSONALIZE ========== -->
                    <StackPanel Spacing="18" VerticalAlignment="Top" Margin="0,8,0,0">
                        <StackPanel Classes="reveal" Spacing="6">
                            <TextBlock Classes="page-title" Text="{loc:Loc 'dialogs.walkthrough.personalize_title'}"/>
                            <TextBlock Classes="page-desc" Text="{loc:Loc 'dialogs.walkthrough.personalize_desc'}"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*, 214">
                            <StackPanel Grid.Column="0" Spacing="18" Margin="0,0,24,0">
                                <StackPanel Classes="reveal" Spacing="8">
                                    <TextBlock Classes="form-label" Text="{loc:Loc 'dialogs.walkthrough.theme_label'}"/>
                                    <Border Background="{DynamicResource BgSurface}" CornerRadius="8" Padding="3">
                                        <Grid ColumnDefinitions="*, *, *">
                                            <Button Grid.Column="0" Classes="segment-btn" Classes.active="{Binding Settings.IsDarkTheme}"
                                                    Command="{Binding Settings.SetThemeCommand}" CommandParameter="Dark"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <icon:PackIconBoxIcons Kind="RegularMoon" Width="13" Height="13" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{loc:Loc 'dialogs.walkthrough.theme_dark'}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Classes="segment-btn" Classes.active="{Binding Settings.IsLightTheme}"
                                                    Command="{Binding Settings.SetThemeCommand}" CommandParameter="Light"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <icon:PackIconBoxIcons Kind="RegularSun" Width="13" Height="13" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{loc:Loc 'dialogs.walkthrough.theme_light'}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="2" Classes="segment-btn" Classes.active="{Binding Settings.IsSystemTheme}"
                                                    Command="{Binding Settings.SetThemeCommand}" CommandParameter="System"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <icon:PackIconBoxIcons Kind="RegularDesktop" Width="13" Height="13" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{loc:Loc 'dialogs.walkthrough.theme_system'}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel Classes="reveal" Spacing="8">
                                    <TextBlock Classes="form-label" Text="{loc:Loc 'dialogs.walkthrough.accent_label'}"/>
                                    <ItemsControl ItemsSource="{Binding Settings.AccentOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:AccentColorItemViewModel">
                                                <Button Classes="swatch-btn" Click="OnSetAccentClick" Tag="{Binding Name}" ToolTip.Tip="{Binding DisplayName}">
                                                    <Grid Width="34" Height="34">
                                                        <Border CornerRadius="17" BorderBrush="{Binding SwatchBrush}" BorderThickness="2" IsVisible="{Binding IsSelected}"/>
                                                        <Border Background="{Binding SwatchBrush}" CornerRadius="13" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <icon:PackIconBoxIcons Kind="RegularCheck" Width="14" Height="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsSelected}"/>
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Classes="feat-desc" Text="{loc:Loc 'dialogs.walkthrough.accent_desc'}"/>
                                </StackPanel>

                                <Grid Classes="reveal" ColumnDefinitions="Auto, *">
                                    <icon:PackIconBoxIcons Kind="RegularPaint" Width="15" Height="15" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                    <TextBlock Grid.Column="1" Classes="feat-desc" Margin="9,0,0,0" Text="{loc:Loc 'dialogs.walkthrough.custom_theme_hint'}"/>
                                </Grid>
                            </StackPanel>

                            <!-- Live preview: built from the app's own brushes, so it follows the picks on the left -->
                            <StackPanel Grid.Column="1" Classes="reveal" Spacing="7">
                                <TextBlock Text="{loc:Loc 'dialogs.walkthrough.preview_label'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSubtle}"/>
                                <Border Classes="mock" BoxShadow="0 8 24 0 #30000000">
                                    <StackPanel>
                                        <Border Background="{DynamicResource BgSidebar}" Padding="6,0" Height="28">
                                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                <Border Classes="mock-tab active"><StackPanel Orientation="Horizontal" Spacing="4"><icon:PackIconBoxIcons Kind="RegularFolder"/><TextBlock Text="{loc:Loc nav.library}"/></StackPanel></Border>
                                                <Border Classes="mock-tab"><StackPanel Orientation="Horizontal" Spacing="4"><icon:PackIconBoxIcons Kind="RegularSpanner"/><TextBlock Text="{loc:Loc nav.tools}"/></StackPanel></Border>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Spacing="10" Margin="12">
                                            <Border Background="{DynamicResource BgSidebar}" CornerRadius="8" Padding="10">
                                                <StackPanel Spacing="9">
                                                    <Grid ColumnDefinitions="*, Auto">
                                                        <Border Classes="bar" Width="70" Background="{DynamicResource TextMuted}" Opacity="0.55"/>
                                                        <Border Grid.Column="1" Classes="mini-toggle on"><Ellipse/></Border>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="*, Auto">
                                                        <Border Classes="bar" Width="52"/>
                                                        <Border Grid.Column="1" Classes="mini-toggle"><Ellipse/></Border>
                                                    </Grid>
                                                    <Border Background="{DynamicResource BgSurface}" CornerRadius="6" Padding="2">
                                                        <Grid ColumnDefinitions="*, *">
                                                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="5" Height="16"/>
                                                            <Border Grid.Column="1" Height="16"/>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                            <Grid ColumnDefinitions="*, Auto">
                                                <Border Background="{DynamicResource AccentBadgeBgBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{loc:Loc 'configurations.active_badge'}" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                </Border>
                                                <Border Grid.Column="1" Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="10,5">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <icon:PackIconBoxIcons Kind="RegularRefreshCw" Width="10" Height="10" Foreground="White" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{loc:Loc 'dialogs.walkthrough.preview_button'}" FontSize="10" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- ========== 8. READY ========== -->
                    <StackPanel Spacing="20" VerticalAlignment="Center" Margin="0,0,0,16">
                        <Panel Classes="reveal" HorizontalAlignment="Center">
                            <Image Classes="float" Source="{SvgImage /Assets/appicon.svg}" Width="104" Height="104"/>
                        </Panel>

                        <StackPanel Classes="reveal" Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'dialogs.walkthrough.ready_title'}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc 'dialogs.walkthrough.ready_desc'}" Classes="page-desc" TextAlignment="Center" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Summary -->
                        <Border Classes="reveal" Background="{DynamicResource BgSurface}" CornerRadius="10" Padding="16,6" MaxWidth="480">
                            <StackPanel>
                                <Grid ColumnDefinitions="Auto, Auto, *" Margin="0,8">
                                    <icon:PackIconBoxIcons Kind="RegularDatabase" Width="15" Height="15" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{loc:Loc 'dialogs.walkthrough.summary_mode'}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="10,0,16,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ModeSummary}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource BorderMain}"/>
                                <Grid ColumnDefinitions="Auto, Auto, *" Margin="0,8">
                                    <icon:PackIconBoxIcons Kind="RegularArchive" Width="15" Height="15" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{loc:Loc 'dialogs.walkthrough.summary_import'}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="10,0,16,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ImportSummary}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ImportSummary}"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource BorderMain}"/>
                                <Grid ColumnDefinitions="Auto, Auto, *" Margin="0,8">
                                    <icon:PackIconBoxIcons Kind="RegularPalette" Width="15" Height="15" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{loc:Loc 'dialogs.walkthrough.summary_look'}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="10,0,16,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding LookSummary}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Tips -->
                        <StackPanel Classes="reveal" Orientation="Horizontal" Spacing="22" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc nav.ctrl_k}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                </Border>
                                <TextBlock Text="{loc:Loc 'dialogs.walkthrough.tip_quick_jump'}" FontSize="11.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icon:PackIconBoxIcons Kind="RegularMove" Width="13" Height="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc 'dialogs.walkthrough.tip_drag_drop'}" FontSize="11.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icon:PackIconBoxIcons Kind="RegularMouse" Width="13" Height="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc 'dialogs.walkthrough.tip_right_click'}" FontSize="11.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Panel>

                <!-- ================= FOOTER ================= -->
                <Border Grid.Row="2" Padding="44,14,44,20">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Button Grid.Column="0" Classes="btn-action-sec" Padding="14,8" VerticalAlignment="Center"
                                Command="{Binding PreviousStepCommand}" IsVisible="{Binding CanGoBack}" IsEnabled="{Binding CanNavigate}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <icon:PackIconBoxIcons Kind="RegularChevronLeft" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc 'dialogs.walkthrough.back_btn'}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Classes="btn-action-primary" Padding="20,8" VerticalAlignment="Center"
                                Command="{Binding NextStepCommand}" IsVisible="{Binding !IsLastStep}" IsEnabled="{Binding CanNavigate}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding NextButtonText}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <icon:PackIconBoxIcons Kind="RegularChevronRight" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Classes="btn-action-primary" Padding="22,9" VerticalAlignment="Center"
                                Command="{Binding FinishCommand}" IsVisible="{Binding IsLastStep}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <icon:PackIconBoxIcons Kind="RegularRocket" Width="15" Height="15" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc 'dialogs.walkthrough.finish_btn'}" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
