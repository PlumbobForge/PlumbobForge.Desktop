<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icon="using:IconPacks.Avalonia.BoxIcons"
        xmlns:loc="using:PlumbobForge.Desktop.MarkupExtensions"
        x:Class="PlumbobForge.Desktop.Views.Dialogs.DeleteSetDialogWindow"
        Title="{loc:Loc 'dialogs.delete_set.title'}"
        Width="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource BgDark}">

    <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource BgDark}">
        <Grid RowDefinitions="Auto, Auto, Auto">
            <!-- Modal Title Bar Header -->
            <Border Grid.Row="0" Background="{DynamicResource BgSidebar}" Height="44" Padding="18,0,0,0" PointerPressed="OnHeaderPointerPressed">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <icon:PackIconBoxIcons Kind="RegularTrash" Width="17" Height="17" Foreground="#ef4444"/>
                        <TextBlock Text="{loc:Loc 'dialogs.delete_set.title'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Width="44" Height="44" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnCancelClick" ToolTip.Tip="{loc:Loc 'common.close'}">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#ef4444"/>
                            </Style>
                            <Style Selector="Button:pointerover icon|PackIconBoxIcons">
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                        <icon:PackIconBoxIcons Kind="RegularX" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Body Content -->
            <Border Grid.Row="1" Padding="22,18">
                <StackPanel Spacing="14">
                    <!-- Main Confirmation Message -->
                    <TextBlock x:Name="MessageTextBlock" Text="{loc:Loc 'dialogs.delete_set.message'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" TextWrapping="Wrap"/>
                    
                    <!-- Sub-set Info Banner -->
                    <Border Background="{DynamicResource BgCardAlt}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <Grid ColumnDefinitions="Auto, *" VerticalAlignment="Center">
                            <icon:PackIconBoxIcons Grid.Column="0" Kind="RegularInfoCircle" Width="16" Height="16" Foreground="#38bdf8" Margin="0,1,10,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Text="{loc:Loc 'dialogs.delete_set.child_info'}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" LineHeight="17"/>
                        </Grid>
                    </Border>

                    <!-- Items Handling Options Box -->
                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{loc:Loc 'dialogs.delete_set.items_action_title'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>

                            <RadioButton x:Name="MoveFilesRadio" GroupName="SetItemsAction" IsChecked="True" Content="{loc:Loc 'dialogs.delete_set.move_to_default'}" FontSize="12.5" Foreground="{DynamicResource TextMain}"/>
                            
                            <RadioButton x:Name="DeleteFilesRadio" GroupName="SetItemsAction" Content="{loc:Loc 'dialogs.delete_set.delete_items'}" FontSize="12.5" Foreground="{DynamicResource TextMain}"/>

                            <CheckBox x:Name="PermanentCheckBox" Margin="26,0,0,0" IsEnabled="{Binding #DeleteFilesRadio.IsChecked}" Content="{loc:Loc 'dialogs.delete_confirm.permanent'}" FontSize="11.5" Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Footer Action Buttons -->
            <Border Grid.Row="2" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <Button Content="{loc:Loc 'common.cancel'}" Click="OnCancelClick" Background="Transparent" Foreground="{DynamicResource TextMain}" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtle}" CornerRadius="7" Padding="16,7" FontSize="12.5" Cursor="Hand"/>
                    <Button Content="{loc:Loc 'dialogs.delete_set.title'}" Click="OnDeleteClick" Background="#dc2626" Foreground="White" FontWeight="SemiBold" BorderThickness="0" CornerRadius="7" Padding="20,7" FontSize="12.5" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
