<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icon="using:PlumbobForge.Desktop.Controls.Icons"
        xmlns:loc="using:PlumbobForge.Desktop.MarkupExtensions"
        x:Class="PlumbobForge.Desktop.Views.Dialogs.ModsSupportPromptWindow"
        Title="{loc:Loc 'dialogs.mods_support.title'}"
        Width="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource BgDark}">

    <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource BgDark}">
        <Grid RowDefinitions="Auto, *, Auto">
            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource BgSidebar}" Height="44" Padding="18,0,0,0" PointerPressed="OnHeaderPointerPressed">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <icon:PackIconBoxIcons Kind="RegularJoystick" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{loc:Loc 'dialogs.mods_support.title'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Width="44" Height="44" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnNotNowClick" ToolTip.Tip="{loc:Loc 'dialogs.mods_support.not_now_btn'}">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#ef4444"/>
                            </Style>
                            <Style Selector="Button:pointerover icon|PackIconBoxIcons">
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                        <icon:PackIconBoxIcons Kind="RegularX" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- What it does -->
            <StackPanel Grid.Row="1" Margin="20,16" Spacing="12">
                <TextBlock Text="{loc:Loc 'dialogs.mods_support.intro'}" FontSize="12.5" Foreground="{DynamicResource TextMain}" TextWrapping="Wrap" LineHeight="18"/>

                <Border Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                    <StackPanel Spacing="9">
                        <Grid ColumnDefinitions="Auto, *">
                            <icon:PackIconBoxIcons Kind="RegularFolder" Width="14" Height="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                            <TextBlock Grid.Column="1" Text="{loc:Loc 'dialogs.mods_support.point_list'}" FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" LineHeight="16" Margin="10,0,0,0"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto, *">
                            <icon:PackIconBoxIcons Kind="RegularSliderAlt" Width="14" Height="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                            <TextBlock Grid.Column="1" Text="{loc:Loc 'dialogs.mods_support.point_configs'}" FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" LineHeight="16" Margin="10,0,0,0"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto, *">
                            <icon:PackIconBoxIcons Kind="RegularSpanner" Width="14" Height="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                            <TextBlock Grid.Column="1" Text="{loc:Loc 'dialogs.mods_support.point_tools'}" FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" LineHeight="16" Margin="10,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{loc:Loc 'dialogs.mods_support.settings_hint'}" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <Button x:Name="NotNowButton"
                            Content="{loc:Loc 'dialogs.mods_support.not_now_btn'}"
                            Click="OnNotNowClick"
                            Background="Transparent"
                            Foreground="{DynamicResource TextMain}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            CornerRadius="7"
                            Padding="16,8"
                            FontSize="12.5"
                            Cursor="Hand"/>
                    <Button x:Name="TurnOnButton"
                            Click="OnTurnOnClick"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            CornerRadius="7"
                            Padding="18,8"
                            FontSize="12.5"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <icon:PackIconBoxIcons Kind="RegularCheck" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc 'dialogs.mods_support.turn_on_btn'}" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
