<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icon="using:IconPacks.Avalonia.BoxIcons"
        xmlns:loc="using:PlumbobForge.Desktop.MarkupExtensions"
        xmlns:vm="using:PlumbobForge.Desktop.ViewModels"
        x:Class="PlumbobForge.Desktop.Views.Dialogs.CasFlagsDialogWindow"
        x:DataType="vm:CasFlagsBatchViewModel"
        Title="{loc:Loc 'dialogs.cas_flags.title'}"
        Width="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource BgDark}">

    <Window.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        </Style>
    </Window.Styles>

    <Window.DataTemplates>
        <!-- One flag: three-state only when the selected parts disagree -->
        <DataTemplate DataType="vm:CasFlagBatchOption">
            <Grid ColumnDefinitions="*, Auto" MinHeight="28">
                <CheckBox Content="{Binding Label}" IsChecked="{Binding State}" IsThreeState="{Binding IsMixed}" FontSize="12.5" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"
                          IsEnabled="{Binding $parent[Window].((vm:CasFlagsBatchViewModel)DataContext).CanEditFlags}"/>
                <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="11.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Window.DataTemplates>

    <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource BgDark}">
        <Grid RowDefinitions="Auto, Auto, Auto">
            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource BgSidebar}" Height="44" Padding="18,0,0,0" PointerPressed="OnHeaderPointerPressed">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <icon:PackIconBoxIcons Kind="RegularHanger" Width="17" Height="17" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{loc:Loc 'dialogs.cas_flags.title'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Width="44" Height="44" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnCloseClick" ToolTip.Tip="{loc:Loc 'common.close'}">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#ef4444"/>
                            </Style>
                            <Style Selector="Button:pointerover icon|PackIconBoxIcons">
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                        <icon:PackIconBoxIcons Kind="RegularX" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Body -->
            <Border Grid.Row="1" Padding="22,18">
                <StackPanel Spacing="14">
                    <StackPanel IsVisible="{Binding IsLoading}" Spacing="10" Margin="0,8">
                        <ProgressBar IsIndeterminate="True" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{loc:Loc 'dialogs.cas_flags.reading'}" FontSize="12.5" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock IsVisible="{Binding HasNoCasParts}" Text="{loc:Loc 'dialogs.cas_flags.no_cas'}" FontSize="13" Foreground="{DynamicResource TextMain}" TextWrapping="Wrap"/>

                    <StackPanel IsVisible="{Binding IsReady}" Spacing="14">
                        <TextBlock Text="{Binding SummaryText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>

                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="section" Text="{loc:Loc 'dialogs.cas_flags.outfits'}" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding OutfitOptions}"/>
                                <TextBlock Classes="section" Text="{loc:Loc 'dialogs.cas_flags.random'}" Margin="0,10,0,4"/>
                                <ContentControl Content="{Binding RandomOption}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock IsVisible="{Binding HasMixed}" Text="{loc:Loc 'dialogs.cas_flags.mixed_hint'}" FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>

                        <Border Background="{DynamicResource BgCardAlt}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                            <Grid ColumnDefinitions="Auto, *">
                                <icon:PackIconBoxIcons Kind="RegularInfoCircle" Width="16" Height="16" Foreground="#38bdf8" Margin="0,1,10,0" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{Binding NoteText}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" LineHeight="17"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <TextBlock IsVisible="{Binding HasStatus}" Text="{Binding StatusMessage}" FontSize="12.5" Foreground="{DynamicResource TextMain}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <Button Content="{Binding CloseButtonText}" Click="OnCloseClick" IsEnabled="{Binding !IsSaving}" Background="Transparent" Foreground="{DynamicResource TextMain}" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtle}" CornerRadius="7" Padding="16,7" FontSize="12.5" Cursor="Hand"/>
                    <Button Classes="btn-action-primary" Content="{loc:Loc 'common.apply'}" Click="OnApplyClick" IsEnabled="{Binding CanApply}" IsVisible="{Binding !IsDone}" Padding="16,7"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
