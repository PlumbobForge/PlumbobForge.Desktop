<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icon="using:IconPacks.Avalonia.BoxIcons"
        xmlns:loc="using:PlumbobForge.Desktop.MarkupExtensions"
        x:Class="PlumbobForge.Desktop.Views.Dialogs.DeleteConfirmDialogWindow"
        Title="{loc:Loc 'dialogs.delete_confirm.title'}"
        Width="440" Height="220"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource BgDark}">

    <Border BorderBrush="#334155" BorderThickness="1" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource BgDark}">
        <Grid RowDefinitions="Auto, *, Auto">
            <!-- Modal Title Bar Header -->
            <Border Grid.Row="0" Background="{DynamicResource BgSidebar}" Height="40" Padding="16,0,0,0" PointerPressed="OnHeaderPointerPressed">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <icon:PackIconBoxIcons Kind="RegularTrash" Width="16" Height="16" Foreground="White"/>
                        <TextBlock Text="{loc:Loc 'dialogs.delete_confirm.title'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Width="40" Height="40" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnCancelClick" ToolTip.Tip="{loc:Loc 'common.close'}">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#ef4444"/>
                            </Style>
                            <Style Selector="Button:pointerover icon|PackIconBoxIcons">
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                        <icon:PackIconBoxIcons Kind="RegularX" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Body Content -->
            <Border Grid.Row="1" Padding="20,16">
                <Grid RowDefinitions="Auto, *">
                    <TextBlock x:Name="MessageTextBlock" Grid.Row="0" Text="{loc:Loc 'dialogs.delete_confirm.message'}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <CheckBox x:Name="PermanentCheckBox" Grid.Row="1" Content="{loc:Loc 'dialogs.delete_confirm.permanent'}" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- Footer Action Buttons -->
            <Border Grid.Row="2" Background="{DynamicResource BgSidebar}" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <Button Content="{loc:Loc 'common.cancel'}" Click="OnCancelClick" Background="#334155" Foreground="{DynamicResource TextMain}" Padding="16,6"/>
                    <Button Content="{loc:Loc 'common.delete'}" Click="OnDeleteClick" Background="#dc2626" Foreground="White" FontWeight="SemiBold" Padding="20,6"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
