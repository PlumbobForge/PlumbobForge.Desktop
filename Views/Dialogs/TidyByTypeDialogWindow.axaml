<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icon="using:PlumbobForge.Desktop.Controls.Icons"
        xmlns:loc="using:PlumbobForge.Desktop.MarkupExtensions"
        x:Class="PlumbobForge.Desktop.Views.Dialogs.TidyByTypeDialogWindow"
        Title="{loc:Loc 'library.tidy_title'}"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource BgDark}">

    <Window.Styles>
        <Style Selector="TextBox.error /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#ef4444"/>
        </Style>
    </Window.Styles>

    <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource BgDark}">
        <Grid RowDefinitions="Auto, Auto, Auto">
            <Border Grid.Row="0" Background="{DynamicResource BgSidebar}" Height="44" Padding="18,0,0,0" PointerPressed="OnHeaderPointerPressed">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <icon:PackIconBoxIcons Kind="RegularFolder" Width="17" Height="17" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{loc:Loc 'library.tidy_title'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Width="44" Height="44" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnCancelClick" ToolTip.Tip="{loc:Loc 'common.close'}">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#ef4444"/>
                            </Style>
                            <Style Selector="Button:pointerover icon|PackIconBoxIcons">
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                        <icon:PackIconBoxIcons Kind="RegularX" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="22,18">
                <StackPanel Spacing="14">
                    <TextBlock Text="{loc:Loc 'library.tidy_intro'}" FontSize="12.5" Foreground="{DynamicResource TextMain}" TextWrapping="Wrap" LineHeight="18"/>

                    <!-- One row per kind: tick to move, the folder under Packages it goes to -->
                    <StackPanel x:Name="GroupsPanel" Spacing="8"/>

                    <Grid ColumnDefinitions="Auto, *">
                        <icon:PackIconBoxIcons Grid.Column="0" Kind="RegularInfoCircle" Width="16" Height="16" Foreground="#38bdf8" Margin="0,1,10,0" VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1" Text="{loc:Loc 'library.tidy_note'}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" LineHeight="17"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <Button Content="{loc:Loc 'common.cancel'}" Click="OnCancelClick" Background="Transparent" Foreground="{DynamicResource TextMain}" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtle}" CornerRadius="7" Padding="16,7" FontSize="12.5" Cursor="Hand"/>
                    <Button x:Name="MoveButton" Classes="btn-action-primary" Click="OnMoveClick" Padding="20,7" FontSize="12.5"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
