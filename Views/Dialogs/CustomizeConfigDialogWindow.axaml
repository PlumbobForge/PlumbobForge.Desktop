<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icon="using:IconPacks.Avalonia.BoxIcons"
        xmlns:loc="using:PlumbobForge.Desktop.MarkupExtensions"
        x:Class="PlumbobForge.Desktop.Views.Dialogs.CustomizeConfigDialogWindow"
        Title="{loc:Loc 'dialogs.customize_config.title'}"
        Width="540" Height="650"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource BgDark}">

    <Window.Styles>
        <!-- Icon Button Styles -->
        <Style Selector="Button.icon-pick-btn">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="{DynamicResource BgSidebar}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.icon-pick-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgCardAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.icon-pick-btn.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBadgeBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Color Swatch Button Styles -->
        <Style Selector="Button.color-pick-btn">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.color-pick-btn:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.15)"/>
        </Style>
        <Style Selector="Button.color-pick-btn.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource TextMain}"/>
        </Style>
    </Window.Styles>

    <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource BgDark}">
        <Grid RowDefinitions="Auto, *, Auto">
            <!-- Modal Title Bar Header -->
            <Border Grid.Row="0" Background="{DynamicResource BgSidebar}" Height="42" Padding="16,0,0,0" PointerPressed="OnHeaderPointerPressed">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <icon:PackIconBoxIcons Kind="RegularPalette" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{loc:Loc 'dialogs.customize_config.title'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Width="42" Height="42" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnCancelClick" ToolTip.Tip="{loc:Loc 'common.close'}">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#ef4444"/>
                            </Style>
                            <Style Selector="Button:pointerover icon|PackIconBoxIcons">
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                        <icon:PackIconBoxIcons Kind="RegularX" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Body Content (Scrollable) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,16" Spacing="16">

                    <!-- Live Preview Card -->
                    <Border Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderMain}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                        <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                            <!-- Preview Icon -->
                            <icon:PackIconBoxIcons x:Name="PreviewIcon" Kind="RegularSlider" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <!-- Preview Text -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{loc:Loc 'dialogs.customize_config.live_preview'}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock x:Name="PreviewName" Text="Configuration Name" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PreviewDescription" Text="Description preview" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Badge Preview -->
                            <Border x:Name="PreviewBadge" Grid.Column="2" Background="{DynamicResource AccentBrush}" CornerRadius="4" Height="18" Padding="6,0" VerticalAlignment="Center" IsVisible="False">
                                <TextBlock x:Name="PreviewBadgeText" Text="{loc:Loc 'dialogs.customize_config.active'}" FontSize="9.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Configuration Name Input -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Loc 'dialogs.customize_config.name_label'}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                        <TextBox x:Name="ConfigNameTextBox" Classes="settings-input" Watermark="{loc:Loc 'dialogs.customize_config.name_watermark'}" FontSize="12.5" TextChanged="OnNameChanged"/>
                        <TextBlock x:Name="ErrorTextBlock" Foreground="#ef4444" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" IsVisible="False"/>
                    </StackPanel>

                    <!-- Description Input -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Loc 'dialogs.customize_config.description_label'}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                        <TextBox x:Name="DescriptionTextBox" Classes="settings-input" Watermark="{loc:Loc 'dialogs.customize_config.description_watermark'}" FontSize="12.5" Height="60" Padding="10,8" VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True" TextChanged="OnDescriptionChanged"/>
                    </StackPanel>

                    <!-- Icon Selection -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Loc 'dialogs.customize_config.choose_icon'}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                        <WrapPanel x:Name="IconsWrapPanel" Orientation="Horizontal" ItemWidth="42" ItemHeight="42">
                            <!-- Dynamically populated icon buttons -->
                        </WrapPanel>
                    </StackPanel>

                    <!-- Color Accent Selection -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Loc 'dialogs.customize_config.choose_color'}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                        <WrapPanel x:Name="ColorsWrapPanel" Orientation="Horizontal" ItemWidth="36" ItemHeight="36">
                            <!-- Color swatch buttons populated in code-behind -->
                        </WrapPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer Action Buttons -->
            <Border Grid.Row="2" Background="{DynamicResource BgSidebar}" Padding="16,12">
                <Grid ColumnDefinitions="Auto, *">
                    <!-- Reset to Default Button -->
                    <Button Grid.Column="0" Content="{loc:Loc 'dialogs.customize_config.reset_default'}" Click="OnResetDefaultClick" Background="Transparent" Foreground="{DynamicResource TextMuted}" FontSize="12" Padding="8,6" Cursor="Hand">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Foreground" Value="#ef4444"/>
                            </Style>
                        </Button.Styles>
                    </Button>

                    <!-- Save / Cancel Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button Content="{loc:Loc 'common.cancel'}" Click="OnCancelClick" Background="{DynamicResource BgCardAlt}" Foreground="{DynamicResource TextMain}" Padding="16,6" CornerRadius="6" Cursor="Hand"/>
                        <Button x:Name="SaveButton" Content="{loc:Loc 'dialogs.customize_config.save_changes'}" Click="OnSaveClick" Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="SemiBold" Padding="18,6" CornerRadius="6" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
