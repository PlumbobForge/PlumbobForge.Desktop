<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icon="using:IconPacks.Avalonia.BoxIcons"
        xmlns:loc="using:PlumbobForge.Desktop.MarkupExtensions"
        x:Class="PlumbobForge.Desktop.Views.Dialogs.PendingCacheWarningDialogWindow"
        Title="{loc:Loc 'dialogs.pending_cache.title'}"
        Width="460" Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource BgDark}">

    <Border BorderBrush="#334155" BorderThickness="1" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource BgDark}">
        <Grid RowDefinitions="Auto, *, Auto">
            <!-- Modal Title Bar Header -->
            <Border Grid.Row="0" Background="{DynamicResource BgSidebar}" Height="40" Padding="16,0,0,0" PointerPressed="OnHeaderPointerPressed">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <icon:PackIconBoxIcons Kind="RegularBadgeExclamation" Width="18" Height="18" Foreground="#eab308"/>
                        <TextBlock Text="{loc:Loc 'dialogs.pending_cache.title'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Width="40" Height="40" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnCancelClick" ToolTip.Tip="{loc:Loc 'common.cancel'}">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#ef4444"/>
                            </Style>
                            <Style Selector="Button:pointerover icon|PackIconBoxIcons">
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                        <icon:PackIconBoxIcons Kind="RegularX" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Body Content -->
            <ScrollViewer Grid.Row="1" Padding="20,16">
                <TextBlock Text="{loc:Loc 'dialogs.pending_cache.message'}"
                           FontSize="12.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" LineHeight="18"/>
            </ScrollViewer>

            <!-- Footer Action Buttons Panel -->
            <Border Grid.Row="2" Background="{DynamicResource BgSidebar}" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="{loc:Loc 'common.cancel'}" Click="OnCancelClick" Background="#1e293b" Foreground="{DynamicResource TextMuted}" Padding="14,6" CornerRadius="6" Cursor="Hand"/>
                    <Button Content="{loc:Loc 'dialogs.pending_cache.close_anyway'}" Click="OnCloseAnywayClick" Background="#dc2626" Foreground="White" FontWeight="SemiBold" Padding="14,6" CornerRadius="6" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
