<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icon="using:IconPacks.Avalonia.BoxIcons"
        xmlns:loc="using:PlumbobForge.Desktop.MarkupExtensions"
        x:Class="PlumbobForge.Desktop.Views.Dialogs.InputDialogWindow"
        Title="{loc:Loc 'dialogs.input.title'}"
        Width="440" Height="220"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource BgDark}">

    <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource BgDark}">
        <Grid RowDefinitions="Auto, *, Auto">
            <!-- Modal Title Bar Header -->
            <Border Grid.Row="0" Background="{DynamicResource BgSidebar}" Height="42" Padding="18,0,0,0" PointerPressed="OnHeaderPointerPressed">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <icon:PackIconBoxIcons Kind="RegularEdit" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock x:Name="TitleTextBlock" Text="{loc:Loc 'dialogs.input.title'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Width="42" Height="42" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnCancelClick" ToolTip.Tip="{loc:Loc 'common.close'}">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#ef4444"/>
                            </Style>
                            <Style Selector="Button:pointerover icon|PackIconBoxIcons">
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                        <icon:PackIconBoxIcons Kind="RegularX" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Body Content -->
            <Border Grid.Row="1" Padding="20,16">
                <StackPanel Spacing="0">
                    <TextBlock x:Name="PromptTextBlock" Text="{loc:Loc 'dialogs.input.prompt'}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10"/>
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBox x:Name="ValueTextBox" Grid.Column="0" Classes="settings-input" Watermark="{loc:Loc 'dialogs.input.watermark'}" VerticalAlignment="Top" TextChanged="OnValueChanged"/>
                        <Border x:Name="ExtensionBadge" Grid.Column="1" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="7" Padding="10,0" Margin="6,0,0,0" VerticalAlignment="Top" Height="34" IsVisible="False">
                            <TextBlock x:Name="ExtensionTextBlock" Text=".package" Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="ErrorTextBlock" Foreground="#ef4444" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" IsVisible="False"/>
                </StackPanel>
            </Border>

            <!-- Footer Action Buttons -->
            <Border Grid.Row="2" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <Button x:Name="CancelButton" Content="{loc:Loc 'common.cancel'}" Click="OnCancelClick" Background="Transparent" Foreground="{DynamicResource TextMain}" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtle}" CornerRadius="7" Padding="16,7" FontSize="12.5" Cursor="Hand"/>
                    <Button x:Name="SaveButton" Content="{loc:Loc 'common.save'}" Click="OnSaveClick" Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="SemiBold" BorderThickness="0" CornerRadius="7" Padding="20,7" FontSize="12.5" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
