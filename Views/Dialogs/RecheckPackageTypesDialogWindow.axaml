<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icon="using:IconPacks.Avalonia.BoxIcons"
        xmlns:loc="using:PlumbobForge.Desktop.MarkupExtensions"
        x:Class="PlumbobForge.Desktop.Views.Dialogs.RecheckPackageTypesDialogWindow"
        Title="{loc:Loc 'dialogs.recheck_types.title'}"
        Width="480" Height="225"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource BgDark}">

    <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource BgDark}">
        <Grid RowDefinitions="Auto, *, Auto">
            <!-- Modal Title Bar Header -->
            <Border Grid.Row="0" Background="{DynamicResource BgSidebar}" Height="42" Padding="18,0,0,0" PointerPressed="OnHeaderPointerPressed">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <icon:PackIconBoxIcons Kind="RegularTag" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{loc:Loc 'dialogs.recheck_types.title'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Width="42" Height="42" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnCancelClick" ToolTip.Tip="{loc:Loc 'common.cancel'}">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#ef4444"/>
                            </Style>
                            <Style Selector="Button:pointerover icon|PackIconBoxIcons">
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                        <icon:PackIconBoxIcons Kind="RegularX" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Body Content -->
            <StackPanel Grid.Row="1" Margin="20,16" Spacing="14">
                <TextBlock Text="{loc:Loc 'dialogs.recheck_types.message'}"
                           FontSize="12.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" LineHeight="18"/>

                <CheckBox x:Name="SkipUserTaggedCheckBox"
                          IsChecked="True"
                          Cursor="Hand"
                          Content="{loc:Loc 'dialogs.recheck_types.skip_user_tagged'}"/>
            </StackPanel>

            <!-- Footer Action Buttons Panel -->
            <Border Grid.Row="2" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="{loc:Loc 'common.cancel'}" Click="OnCancelClick" Background="Transparent" Foreground="{DynamicResource TextMain}" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtle}" CornerRadius="7" Padding="16,7" FontSize="12.5" Cursor="Hand"/>
                    <Button Content="{loc:Loc 'dialogs.recheck_types.start'}" Click="OnStartClick" Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="SemiBold" BorderThickness="0" CornerRadius="7" Padding="20,7" FontSize="12.5" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
