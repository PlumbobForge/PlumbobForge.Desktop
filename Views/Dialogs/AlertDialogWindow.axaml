<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icon="using:IconPacks.Avalonia.BoxIcons"
        xmlns:loc="using:PlumbobForge.Desktop.MarkupExtensions"
        x:Class="PlumbobForge.Desktop.Views.Dialogs.AlertDialogWindow"
        Title="{loc:Loc 'dialogs.alert.title'}"
        Width="480" Height="240"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource BgDark}">

    <Border BorderBrush="#334155" BorderThickness="1" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource BgDark}">
        <Grid RowDefinitions="Auto, *, Auto">
            <!-- Modal Title Bar Header -->
            <Border Grid.Row="0" Background="{DynamicResource BgSidebar}" Height="40" Padding="16,0,0,0" PointerPressed="OnHeaderPointerPressed">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <icon:PackIconBoxIcons Kind="RegularBadgeExclamation" Width="16" Height="16" Foreground="White"/>
                        <TextBlock x:Name="TitleTextBlock" Text="Duplicate File Import" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Width="40" Height="40" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnCancelClick" ToolTip.Tip="{loc:Loc 'common.close'}">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#ef4444"/>
                            </Style>
                            <Style Selector="Button:pointerover icon|PackIconBoxIcons">
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                        <icon:PackIconBoxIcons Kind="RegularX" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Body Content -->
            <ScrollViewer Grid.Row="1" Padding="20,16">
                <TextBlock x:Name="MessageTextBlock" Text="One or more files already exist in your library. How would you like to handle duplicates?" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
            </ScrollViewer>

            <!-- Footer Action Buttons Panel -->
            <Border Grid.Row="2" Background="{DynamicResource BgSidebar}" Padding="16,10">
                <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="{loc:Loc 'dialogs.duplicate.rename_all'}" Click="OnRenameAllClick" Background="#3b82f6" Foreground="White" Padding="12,6"/>
                    <Button Content="{loc:Loc 'dialogs.duplicate.replace_all'}" Click="OnReplaceAllClick" Background="#eab308" Foreground="Black" FontWeight="SemiBold" Padding="12,6"/>
                    <Button Content="{loc:Loc 'dialogs.duplicate.skip_all'}" Click="OnSkipAllClick" Background="#334155" Foreground="{DynamicResource TextMain}" Padding="12,6"/>
                    <Button Content="{loc:Loc 'common.cancel'}" Click="OnCancelClick" Background="#1e293b" Foreground="{DynamicResource TextMuted}" Padding="12,6"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
