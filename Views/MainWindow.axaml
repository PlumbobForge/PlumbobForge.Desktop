<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PlumbobForge.Desktop.ViewModels"
        xmlns:views="using:PlumbobForge.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="using:PlumbobForge.Desktop.MarkupExtensions"
        xmlns:bx="using:PlumbobForge.Desktop.Controls.Icons"
        xmlns:controls="using:PlumbobForge.Desktop.Controls"
        xmlns:services="using:PlumbobForge.Desktop.Services"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="PlumbobForge.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:Name="RootWindow"
        Title="PlumbobForge"
        Icon="/Assets/appicon.ico"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        TransparencyLevelHint="Mica, AcrylicBlur, Transparent"
        TransparencyBackgroundFallback="#1A1C22"
        Background="{DynamicResource BgDark}">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+K" Command="{Binding OpenQuickSwitcherCommand}" />
        <KeyBinding Gesture="Ctrl+P" Command="{Binding OpenQuickSwitcherCommand}" />
        <KeyBinding Gesture="F1" Command="{Binding ToggleGuideCommand}" />
    </Window.KeyBindings>

    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type vm:ContentManagerViewModel}">
            <views:ContentManagerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfigurationsViewModel}">
            <views:ConfigurationsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HealthViewModel}">
            <views:HealthView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Styles>
        <Style Selector="Button.win-btn">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Button.win-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource BgCardAlt}"/>
        </Style>
        <Style Selector="Button.win-btn-close:pointerover">
            <Setter Property="Background" Value="#E81123"/>
        </Style>
        <Style Selector="Button.win-btn-close:pointerover bx|PackIconBoxIcons">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.nav-action-btn">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style Selector="Button.nav-action-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgCardAlt}"/>
        </Style>
        <Style Selector="Button.nav-action-btn:pointerover bx|PackIconBoxIcons">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        </Style>
        <Style Selector="Button.nav-action-btn.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBadgeBgBrush}"/>
        </Style>
        <Style Selector="Button.nav-action-btn.active bx|PackIconBoxIcons">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <!-- Play split button: accent normally, amber when a rebuild waits, quiet while the game runs -->
        <Style Selector="Border.play-group">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <Style Selector="Border.play-group.dirty">
            <Setter Property="Background" Value="#E5A93C"/>
        </Style>
        <Style Selector="Border.play-group.running">
            <Setter Property="Background" Value="{DynamicResource BgCardAlt}"/>
        </Style>
        <Style Selector="Border.play-divider">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="0,7"/>
            <Setter Property="Background" Value="#40FFFFFF"/>
        </Style>
        <Style Selector="Border.play-group.running Border.play-divider">
            <Setter Property="Background" Value="{DynamicResource BorderSubtle}"/>
        </Style>
        <Style Selector="Button.play-main, Button.play-menu">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.play-main">
            <Setter Property="Padding" Value="12,0,12,0"/>
        </Style>
        <Style Selector="Button.play-menu">
            <Setter Property="Padding" Value="10,0,9,0"/>
        </Style>
        <Style Selector="Button.play-main /template/ ContentPresenter#PART_ContentPresenter, Button.play-menu /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.play-main:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.play-menu:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.play-main:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.play-menu:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#33000000"/>
        </Style>
        <Style Selector="Button.play-main:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D0FFFFFF"/>
        </Style>
        <Style Selector="Button.play-main bx|PackIconBoxIcons, Button.play-menu bx|PackIconBoxIcons">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Border.play-group.running Button.play-main /template/ ContentPresenter#PART_ContentPresenter, Border.play-group.running Button.play-menu /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>
        <Style Selector="Border.play-group.running Button.play-menu:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgSurfaceHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        </Style>
        <Style Selector="Border.play-group.running bx|PackIconBoxIcons">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>
        <Style Selector="Button.nav-tab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,6,12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.nav-tab:pointerover /template/ Border">
            <Setter Property="Background" Value="{DynamicResource BgCardAlt}"/>
        </Style>
        <Style Selector="Button.nav-tab:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        </Style>
        <Style Selector="Button.nav-tab:pointerover bx|PackIconBoxIcons">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        </Style>
        <Style Selector="Button.nav-tab.active /template/ Border">
            <Setter Property="Background" Value="{DynamicResource AccentBadgeBgBrush}"/>
        </Style>
        <Style Selector="Button.nav-tab.active TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
        </Style>
        <Style Selector="Button.nav-tab.active bx|PackIconBoxIcons">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <!-- Titles only show as tooltips once the bar has dropped them. -->
        <Style Selector="Button.nav-tab">
            <Setter Property="ToolTip.ServiceEnabled" Value="False"/>
        </Style>
        <Style Selector="Button.nav-tab.compact">
            <Setter Property="ToolTip.ServiceEnabled" Value="True"/>
            <Setter Property="Padding" Value="10,6,10,6"/>
        </Style>
        <Style Selector="Button.nav-tab.compact TextBlock.tab-label">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Window[WindowState=Maximized] Border#RootBorder">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Styles>

    <Border x:Name="RootBorder"
            BorderBrush="{DynamicResource BorderMain}"
            BorderThickness="1"
            Margin="{Binding #RootWindow.OffScreenMargin}">
        <Grid RowDefinitions="Auto,*">
            <!-- Custom Title Bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BgSidebar}"
                    Height="44"
                    Padding="10,0,0,0"
                    PointerPressed="OnHeaderPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <!-- Left: Navigation Tabs (titles hide when they don't fit) -->
                    <ItemsControl Grid.Column="0"
                                  ItemsSource="{Binding NavTabs}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:AdaptiveTabPanel Spacing="2" LabelSpacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavTabViewModel}">
                                <Button Classes="nav-tab"
                                        Classes.active="{Binding IsActive}"
                                        IsVisible="{Binding IsShown}"
                                        Command="{Binding Command}"
                                        ToolTip.Tip="{Binding Title}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <bx:PackIconBoxIcons Kind="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Classes="tab-label" Text="{Binding Title}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Right: Quick search, Rebuild button & Window controls -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Right">
                        <!-- Quick Jump Search Trigger Button -->
                        <Button x:Name="QuickJumpButton"
                                Classes="nav-action-btn"
                                controls:GuideTarget.Id="titlebar.quick-jump"
                                Command="{Binding OpenQuickSwitcherCommand}"
                                CommandParameter="click"
                                ToolTip.Tip="{loc:Loc common.quick_jump}">
                            <bx:PackIconBoxIcons Kind="RegularSearch" Width="15" Height="15" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Help: the guide, What's New and bug reports -->
                        <Button x:Name="HelpButton"
                                Classes="nav-action-btn"
                                Classes.active="{Binding IsGuideOpen}"
                                controls:GuideTarget.Id="titlebar.help"
                                Click="OnHelpClick"
                                ToolTip.Tip="{Binding HelpTip}">
                            <Button.ContextMenu>
                                <ContextMenu Placement="BottomEdgeAlignedRight"/>
                            </Button.ContextMenu>
                            <Panel>
                                <bx:PackIconBoxIcons Kind="RegularHelpCircle" Width="16" Height="16" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <!-- New-spot dot while the moved-feedback callout is up -->
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Margin="0,-3,-4,0" IsVisible="{Binding IsHelpMoveTipVisible}"/>
                            </Panel>
                        </Button>

                        <!-- One-time callout for users who had the old bug button -->
                        <Popup x:Name="HelpMoveTip"
                               PlacementTarget="{Binding #HelpButton}"
                               Placement="BottomEdgeAlignedRight"
                               VerticalOffset="8"
                               ShouldUseOverlayLayer="True"
                               IsLightDismissEnabled="False"
                               IsOpen="{Binding IsHelpMoveTipVisible}">
                            <Border Classes="card" Width="280" Padding="14,12" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}"
                                    Background="{DynamicResource BgCard}" CornerRadius="10" BoxShadow="0 6 18 0 #55000000">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{loc:Loc nav.help_moved_title}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextMain}"/>
                                    <TextBlock Text="{loc:Loc nav.help_moved_body}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                                        <Button x:Name="HelpMoveTipOk" Classes="btn-action-sec" Content="{loc:Loc nav.help_moved_ok}" Command="{Binding DismissHelpMoveTipCommand}"/>
                                        <Button x:Name="HelpMoveTipShow" Classes="btn-action-primary" Content="{loc:Loc nav.help_moved_show}" Click="OnHelpMoveTipShowClick"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- Play: starts the game (rebuilding first when needed); the right half switches the configuration -->
                        <Border x:Name="PlayGroup"
                                Classes="play-group"
                                Classes.dirty="{Binding NeedsRebuildToPlay}"
                                Classes.running="{Binding IsGameRunning}"
                                controls:GuideTarget.Id="titlebar.play"
                                Margin="2,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="PlayButton"
                                        Classes="play-main"
                                        Command="{Binding PlayCommand}"
                                        IsEnabled="{Binding CanPlay}"
                                        ToolTip.Tip="{Binding PlayTip}">
                                    <Button.ContextMenu>
                                        <ContextMenu IsVisible="{Binding !IsVaultActive}">
                                            <MenuItem Header="{loc:Loc common.force_rebuild}" Command="{Binding ForceRebuildCacheCommand}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <bx:PackIconBoxIcons Kind="RegularPlay" Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding ShowPlayIcon}"/>
                                        <TextBlock Text="{Binding PlayText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Border Classes="play-divider"/>
                                <Button x:Name="PlayMenuButton"
                                        Classes="play-menu"
                                        Click="OnPlayMenuClick"
                                        ToolTip.Tip="{Binding ConfigTip}">
                                    <Button.ContextMenu>
                                        <ContextMenu Placement="BottomEdgeAlignedRight"/>
                                    </Button.ContextMenu>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="{Binding ActiveConfigName}" FontSize="11.5" MaxWidth="120" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <bx:PackIconBoxIcons Kind="RegularChevronDown" Width="12" Height="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Minimize -->
                        <Button Classes="win-btn"
                                Click="OnMinimizeClick"
                                ToolTip.Tip="{loc:Loc nav.minimize}">
                            <bx:PackIconBoxIcons Kind="RegularMinus" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Maximize / Restore -->
                        <Button Classes="win-btn"
                                Click="OnMaximizeRestoreClick"
                                ToolTip.Tip="{loc:Loc nav.maximize}">
                            <bx:PackIconBoxIcons x:Name="MaximizeIcon" Kind="RegularSquare" Width="12" Height="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Close -->
                        <Button Classes="win-btn win-btn-close"
                                Click="OnCloseClick"
                                ToolTip.Tip="{loc:Loc nav.close}">
                            <bx:PackIconBoxIcons Kind="RegularX" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area (Persistent tab views for instant switching & state preservation) -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                <Grid Grid.Column="0">
                    <ContentControl Content="{Binding ContentManagerVm}"
                                    IsVisible="{Binding IsContentManagerActive}"/>
                    <ContentControl Content="{Binding ConfigurationsVm}"
                                    IsVisible="{Binding IsConfigurationsActive}"/>
                    <ContentControl Content="{Binding HealthVm}"
                                    IsVisible="{Binding IsToolsActive}"/>
                    <ContentControl Content="{Binding SettingsVm}"
                                    IsVisible="{Binding IsSettingsActive}"/>
                </Grid>

                <!-- Guide: docked beside the app so it can be followed while using it -->
                <Panel Grid.Column="1" Width="360" IsVisible="{Binding IsGuideOpen}">
                    <views:GuidePanelView x:Name="GuidePanel" DataContext="{Binding Guide}"/>
                </Panel>
            </Grid>

            <!-- Quick Switcher Modal Overlay -->
            <views:QuickSwitcherOverlayView Grid.RowSpan="2"
                                            DataContext="{Binding QuickSwitcher}"/>

            <!-- Toasts stack in the bottom-right corner so several can show at once -->
            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,24,24"
                        Spacing="12"
                        ZIndex="90">

            <!-- Library action toast: what just happened, with Undo when it can be taken back -->
            <Border HorizontalAlignment="Right"
                    MaxWidth="460"
                    Background="{DynamicResource BgSidebar}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,8,8,8"
                    BoxShadow="0 8 24 #66000000"
                    IsVisible="{Binding ActionToast.IsVisible}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                    <bx:PackIconBoxIcons Grid.Column="0" Kind="RegularCheckCircle" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding ActionToast.Message}" FontSize="12.5" Foreground="{DynamicResource TextMain}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Classes="btn-action-sec" Command="{Binding ActionToast.UndoCommand}" IsVisible="{Binding ActionToast.CanUndo}"
                            Content="{loc:Loc library.toast_undo}" Margin="12,0,4,0" Padding="12,5" VerticalAlignment="Center"/>
                    <Button Grid.Column="3"
                            Command="{Binding ActionToast.DismissCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6"
                            CornerRadius="6"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{loc:Loc app.dismiss}">
                        <bx:PackIconBoxIcons Kind="RegularX" Width="13" Height="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- What's New Toast (first launch after an update) -->
            <Border HorizontalAlignment="Right"
                    MaxWidth="420"
                    Background="{DynamicResource BgSidebar}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,14,16,14"
                    BoxShadow="0 8 24 #66000000"
                    IsVisible="{Binding IsWhatsNewToastVisible}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{Binding WhatsNewTitle}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextMain}"/>
                        <TextBlock Text="{Binding WhatsNewSubtitle}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                   IsVisible="{Binding !HasWhatsNewHighlights}"/>
                        <ItemsControl ItemsSource="{Binding WhatsNewHighlights}" IsVisible="{Binding HasWhatsNewHighlights}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:ChangelogHighlight">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0" Text="•" FontSize="12" Margin="0,0,8,0" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap">
                                            <Run Text="{Binding Lead}" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/><Run Text="{Binding Text}"/>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding DismissWhatsNewToastCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6"
                            CornerRadius="6"
                            Cursor="Hand"
                            VerticalAlignment="Top"
                            ToolTip.Tip="{loc:Loc app.dismiss}">
                        <bx:PackIconBoxIcons Kind="RegularX" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Update Notification Toast -->
            <Border HorizontalAlignment="Right"
                    Background="{DynamicResource BgSidebar}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,12,16,12"
                    BoxShadow="0 8 24 #66000000"
                    IsVisible="{Binding IsUpdateToastVisible}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                    <Border Grid.Column="0"
                            Background="{DynamicResource AccentBadgeBgBrush}"
                            CornerRadius="8"
                            Width="36" Height="36"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <bx:PackIconBoxIcons Kind="RegularRocket" Width="18" Height="18"
                                             Foreground="{DynamicResource AccentBrush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{loc:Loc settings.update_available}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextMain}"/>
                        <TextBlock Text="{Binding UpdateToastMessage}" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Command="{Binding OpenUpdateSettingsCommand}"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="#FFFFFF"
                            FontWeight="DemiBold"
                            FontSize="12"
                            Padding="12,6,12,6"
                            CornerRadius="6"
                            Cursor="Hand"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <bx:PackIconBoxIcons Kind="RegularRocket" Width="13" Height="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc settings.go_update}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3"
                            Command="{Binding DismissUpdateToastCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6"
                            CornerRadius="6"
                            Cursor="Hand"
                            ToolTip.Tip="Dismiss">
                        <bx:PackIconBoxIcons Kind="RegularX" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            </StackPanel>

            <!-- Global Modal Overlay Host (Background Task Progress) -->
            <Grid Grid.RowSpan="2"
                  Background="#99000000"
                  IsVisible="{Binding ActiveProgressModal, Converter={x:Static ObjectConverters.IsNotNull}}"
                  ClipToBounds="True">
                <ContentControl Content="{Binding ActiveProgressModal}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
