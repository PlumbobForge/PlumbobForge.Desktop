<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PlumbobForge.Desktop.ViewModels"
        xmlns:views="using:PlumbobForge.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="using:PlumbobForge.Desktop.MarkupExtensions"
        xmlns:bx="clr-namespace:IconPacks.Avalonia.BoxIcons;assembly=IconPacks.Avalonia.BoxIcons"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="PlumbobForge.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:Name="RootWindow"
        Title="PlumbobForge"
        Icon="/Assets/appicon.ico"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        TransparencyLevelHint="Mica, AcrylicBlur, Transparent"
        TransparencyBackgroundFallback="#1A1C22"
        Background="{DynamicResource BgDark}">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+K" Command="{Binding OpenQuickSwitcherCommand}" />
        <KeyBinding Gesture="Ctrl+P" Command="{Binding OpenQuickSwitcherCommand}" />
    </Window.KeyBindings>

    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type vm:ContentManagerViewModel}">
            <views:ContentManagerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfigurationsViewModel}">
            <views:ConfigurationsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HealthViewModel}">
            <views:HealthView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Styles>
        <Style Selector="Button.win-btn">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Button.win-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource BgCardAlt}"/>
        </Style>
        <Style Selector="Button.win-btn-close:pointerover">
            <Setter Property="Background" Value="#E81123"/>
        </Style>
        <Style Selector="Button.win-btn-close:pointerover bx|PackIconBoxIcons">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.nav-action-btn">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style Selector="Button.nav-action-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgCardAlt}"/>
        </Style>
        <Style Selector="Button.nav-action-btn:pointerover bx|PackIconBoxIcons">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        </Style>
        <Style Selector="Button.quick-search-trigger-btn">
            <Setter Property="Width" Value="NaN"/>
            <Setter Property="Padding" Value="8,4,8,4"/>
        </Style>
        <Style Selector="Button.rebuild-btn">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.rebuild-btn bx|PackIconBoxIcons">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>
        <Style Selector="Button.rebuild-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgCardAlt}"/>
        </Style>
        <Style Selector="Button.rebuild-btn:pointerover bx|PackIconBoxIcons">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        </Style>
        <Style Selector="Button.rebuild-btn.dirty">
            <Setter Property="Background" Value="#E5A93C"/>
        </Style>
        <Style Selector="Button.rebuild-btn.dirty /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E5A93C"/>
        </Style>
        <Style Selector="Button.rebuild-btn.dirty:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F5B94C"/>
        </Style>
        <Style Selector="Button.rebuild-btn.dirty bx|PackIconBoxIcons">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.rebuild-btn.dirty:pointerover bx|PackIconBoxIcons">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="RadioButton.nav-tab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,6,12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.nav-tab:pointerover /template/ Border">
            <Setter Property="Background" Value="{DynamicResource BgCardAlt}"/>
        </Style>
        <Style Selector="RadioButton.nav-tab:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        </Style>
        <Style Selector="RadioButton.nav-tab:pointerover bx|PackIconBoxIcons">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        </Style>
        <Style Selector="RadioButton.nav-tab:checked /template/ Border">
            <Setter Property="Background" Value="{DynamicResource AccentBadgeBgBrush}"/>
        </Style>
        <Style Selector="RadioButton.nav-tab:checked TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
        </Style>
        <Style Selector="RadioButton.nav-tab:checked bx|PackIconBoxIcons">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Window[WindowState=Maximized] Border#RootBorder">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Styles>

    <Border x:Name="RootBorder"
            BorderBrush="{DynamicResource BorderMain}"
            BorderThickness="1"
            Margin="{Binding #RootWindow.OffScreenMargin}">
        <Grid RowDefinitions="Auto,*">
            <!-- Custom Title Bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BgSidebar}"
                    Height="44"
                    Padding="10,0,0,0"
                    PointerPressed="OnHeaderPointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <!-- Left: Navigation Tabs -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Spacing="2">
                        <RadioButton Classes="nav-tab"
                                     GroupName="NavGroup"
                                     IsChecked="{Binding IsContentManagerActive, Mode=OneWay}"
                                     Command="{Binding NavigateToContentManagerCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <bx:PackIconBoxIcons Kind="RegularFolder" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc nav.library}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Classes="nav-tab"
                                     GroupName="NavGroup"
                                     IsChecked="{Binding IsConfigurationsActive, Mode=OneWay}"
                                     Command="{Binding NavigateToConfigurationsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <bx:PackIconBoxIcons Kind="RegularSliderAlt" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc nav.configurations}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Classes="nav-tab"
                                     GroupName="NavGroup"
                                     IsChecked="{Binding IsToolsActive, Mode=OneWay}"
                                     Command="{Binding NavigateToToolsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <bx:PackIconBoxIcons Kind="RegularSpanner" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc nav.tools}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Classes="nav-tab"
                                     GroupName="NavGroup"
                                     IsChecked="{Binding IsSettingsActive, Mode=OneWay}"
                                     Command="{Binding NavigateToSettingsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <bx:PackIconBoxIcons Kind="RegularCog" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc nav.settings}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Right: Quick search, Rebuild button & Window controls -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Right">
                        <!-- Quick Jump Search Trigger Button -->
                        <Button Classes="nav-action-btn quick-search-trigger-btn"
                                Command="{Binding OpenQuickSwitcherCommand}"
                                ToolTip.Tip="{loc:Loc common.quick_jump}">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <bx:PackIconBoxIcons Kind="RegularSearch" Width="13" Height="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc nav.quick_jump}" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource BgCardAlt}"
                                        BorderBrush="{DynamicResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="5,1,5,1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc nav.ctrl_k}" FontSize="9" FontWeight="DemiBold" Foreground="{DynamicResource TextMuted}"/>
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- Rebuild Cache Button -->
                        <Button Classes="nav-action-btn rebuild-btn"
                                Classes.dirty="{Binding HasDirtySets}"
                                Command="{Binding RebuildCacheCommand}"
                                ToolTip.Tip="{loc:Loc common.rebuild_cache}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{loc:Loc common.force_rebuild}"
                                              Command="{Binding ForceRebuildCacheCommand}">
                                        <MenuItem.Icon>
                                            <bx:PackIconBoxIcons Kind="RegularRefreshCwDot" Width="16" Height="16" Foreground="{DynamicResource StatusAmber}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <bx:PackIconBoxIcons Kind="RegularRefreshCw" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Minimize -->
                        <Button Classes="win-btn"
                                Click="OnMinimizeClick"
                                ToolTip.Tip="{loc:Loc nav.minimize}">
                            <bx:PackIconBoxIcons Kind="RegularMinus" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Maximize / Restore -->
                        <Button Classes="win-btn"
                                Click="OnMaximizeRestoreClick"
                                ToolTip.Tip="{loc:Loc nav.maximize}">
                            <bx:PackIconBoxIcons x:Name="MaximizeIcon" Kind="RegularSquare" Width="12" Height="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Close -->
                        <Button Classes="win-btn win-btn-close"
                                Click="OnCloseClick"
                                ToolTip.Tip="{loc:Loc nav.close}">
                            <bx:PackIconBoxIcons Kind="RegularX" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <TransitioningContentControl Grid.Row="1"
                                         Content="{Binding CurrentView}">
                <TransitioningContentControl.PageTransition>
                    <CrossFade Duration="0:00:00.150"/>
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>

            <!-- Quick Switcher Modal Overlay -->
            <views:QuickSwitcherOverlayView Grid.RowSpan="2"
                                            DataContext="{Binding QuickSwitcher}"/>

            <!-- Update Notification Toast -->
            <Border Grid.Row="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,24,24"
                    Background="{DynamicResource BgSidebar}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,12,16,12"
                    BoxShadow="0 8 24 #66000000"
                    IsVisible="{Binding IsUpdateToastVisible}"
                    ZIndex="90">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                    <Border Grid.Column="0"
                            Background="{DynamicResource AccentBadgeBgBrush}"
                            CornerRadius="8"
                            Width="36" Height="36"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <bx:PackIconBoxIcons Kind="RegularRocket" Width="18" Height="18"
                                             Foreground="{DynamicResource AccentBrush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{loc:Loc settings.update_available}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextMain}"/>
                        <TextBlock Text="{Binding UpdateToastMessage}" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Command="{Binding OpenUpdateSettingsCommand}"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="#FFFFFF"
                            FontWeight="DemiBold"
                            FontSize="12"
                            Padding="12,6,12,6"
                            CornerRadius="6"
                            Cursor="Hand"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <bx:PackIconBoxIcons Kind="RegularRocket" Width="13" Height="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc settings.go_update}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3"
                            Command="{Binding DismissUpdateToastCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6"
                            CornerRadius="6"
                            Cursor="Hand"
                            ToolTip.Tip="Dismiss">
                        <bx:PackIconBoxIcons Kind="RegularX" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Cache Optimization Notice Toast -->
            <Border Grid.Row="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,24,24"
                    MaxWidth="480"
                    Background="{DynamicResource BgSidebar}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,14,16,14"
                    BoxShadow="0 8 24 #66000000"
                    IsVisible="{Binding IsCacheOptimizationToastVisible}"
                    ZIndex="89">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" VerticalAlignment="Center">
                    <Border Grid.Row="0" Grid.Column="0"
                            Background="{DynamicResource AccentBadgeBgBrush}"
                            CornerRadius="8"
                            Width="36" Height="36"
                            Margin="0,0,12,0"
                            VerticalAlignment="Top">
                        <bx:PackIconBoxIcons Kind="RegularRefreshCw" Width="18" Height="18"
                                             Foreground="{DynamicResource AccentBrush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{loc:Loc app.cache_optimization_title}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextMain}"/>
                        <TextBlock Text="{loc:Loc app.cache_optimization_message}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Row="0" Grid.Column="2"
                            Command="{Binding DismissCacheOptimizationToastCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6"
                            CornerRadius="6"
                            Cursor="Hand"
                            VerticalAlignment="Top"
                            ToolTip.Tip="{loc:Loc app.dismiss}">
                        <bx:PackIconBoxIcons Kind="RegularX" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                    </Button>
                    <!-- Action buttons -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="0,10,0,0">
                        <Button Command="{Binding ForceRebuildFromToastCommand}"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="#FFFFFF"
                                FontWeight="DemiBold"
                                FontSize="12"
                                Padding="12,6,12,6"
                                CornerRadius="6"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <bx:PackIconBoxIcons Kind="RegularRefreshCwDot" Width="13" Height="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc app.rebuild_now}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DismissCacheOptimizationToastCommand}"
                                Background="{DynamicResource BgCardAlt}"
                                Foreground="{DynamicResource TextMain}"
                                FontWeight="DemiBold"
                                FontSize="12"
                                Padding="12,6,12,6"
                                CornerRadius="6"
                                Cursor="Hand">
                            <TextBlock Text="{loc:Loc app.later}" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Global Modal Overlay Host (Background Task Progress) -->
            <Grid Grid.RowSpan="2"
                  Background="#99000000"
                  IsVisible="{Binding ActiveProgressModal, Converter={x:Static ObjectConverters.IsNotNull}}"
                  ClipToBounds="True">
                <ContentControl Content="{Binding ActiveProgressModal}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
