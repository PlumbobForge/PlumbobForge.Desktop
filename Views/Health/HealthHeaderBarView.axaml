<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PlumbobForge.Desktop.ViewModels"
             xmlns:icon="using:PlumbobForge.Desktop.Controls.Icons"
             xmlns:loc="using:PlumbobForge.Desktop.MarkupExtensions"
             xmlns:health="using:PlumbobForge.Desktop.Views.Health"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="100"
             x:Class="PlumbobForge.Desktop.Views.Health.HealthHeaderBarView"
             x:DataType="vm:HealthViewModel">

    <!-- Top Header Card -->
    <Border Classes="settings-card" Padding="16,12">
        <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
            <!-- Left: Custom Dropdown Tool Selector -->
            <Button Grid.Column="0"
                    Background="{DynamicResource BgSurface}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,7"
                    Cursor="Hand"
                    VerticalAlignment="Center">
                <Button.Styles>
                    <Style Selector="Button:pointerover">
                        <Setter Property="Background" Value="{DynamicResource BgSurfaceHover}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    </Style>
                </Button.Styles>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Panel VerticalAlignment="Center">
                        <icon:PackIconBoxIcons Kind="RegularTrash" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsCacheCleanerActive}"/>
                        <icon:PackIconBoxIcons Kind="RegularShield" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsConflictScannerActive}"/>
                        <icon:PackIconBoxIcons Kind="RegularPalette" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsPatternFixerActive}"/>
                        <icon:PackIconBoxIcons Kind="RegularLayers" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsCollectionCreatorActive}"/>
                        <icon:PackIconBoxIcons Kind="RegularCube" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsMeshReportActive}"/>
                        <icon:PackIconBoxIcons Kind="RegularMagicWand" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsOptimizerActive}"/>
                    </Panel>

                    <TextBlock Text="{Binding ActiveToolTitle}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>

                    <icon:PackIconBoxIcons Kind="RegularChevronDown" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>

                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <Border Padding="6" Width="260" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8">
                            <Border.Styles>
                                <Style Selector="Button.tool-pin-btn">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="6"/>
                                    <Setter Property="Margin" Value="8,0,0,0"/>
                                    <Setter Property="CornerRadius" Value="6"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Style>
                                <Style Selector="Button.tool-pin-btn icon|PackIconBoxIcons">
                                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                </Style>
                                <Style Selector="Button.tool-pin-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource BgCardAlt}"/>
                                </Style>
                                <Style Selector="Button.tool-pin-btn:pointerover icon|PackIconBoxIcons">
                                    <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                                </Style>
                                <Style Selector="Button.tool-pin-btn.pinned icon|PackIconBoxIcons">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                </Style>
                            </Border.Styles>
                            <StackPanel Spacing="4">
                                <!-- 1. Cache Cleaner Option -->
                                <Button Command="{Binding SelectSectionCommand}" CommandParameter="Cache"
                                        Background="Transparent" HorizontalAlignment="Stretch" Padding="10,8" CornerRadius="6" Cursor="Hand">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover">
                                            <Setter Property="Background" Value="{DynamicResource BgSurfaceHover}"/>
                                        </Style>
                                    </Button.Styles>
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <icon:PackIconBoxIcons Grid.Column="0" Kind="RegularTrash" Width="20" Height="20" Foreground="{DynamicResource TextMain}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc 'tools.cache.title'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                                            <TextBlock Text="{loc:Loc 'tools.cache.clean_cache'}" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="tool-pin-btn" Classes.pinned="{Binding IsCachePinned}"
                                                Command="{Binding TogglePinSectionCommand}" CommandParameter="Cache"
                                                ToolTip.Tip="{Binding CachePinTip}">
                                            <Panel>
                                                <icon:PackIconBoxIcons Kind="RegularPin" Width="14" Height="14" IsVisible="{Binding !IsCachePinned}"/>
                                                <icon:PackIconBoxIcons Kind="SolidPin" Width="14" Height="14" IsVisible="{Binding IsCachePinned}"/>
                                            </Panel>
                                        </Button>
                                    </Grid>
                                </Button>

                                <!-- 2. Conflict Scanner Option -->
                                <Button Command="{Binding SelectSectionCommand}" CommandParameter="Conflicts"
                                        Background="Transparent" HorizontalAlignment="Stretch" Padding="10,8" CornerRadius="6" Cursor="Hand">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover">
                                            <Setter Property="Background" Value="{DynamicResource BgSurfaceHover}"/>
                                        </Style>
                                    </Button.Styles>
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <icon:PackIconBoxIcons Grid.Column="0" Kind="RegularShield" Width="20" Height="20" Foreground="{DynamicResource TextMain}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc 'tools.conflicts.title'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                                            <TextBlock Text="{loc:Loc 'tools.conflicts.scan_for_conflicts'}" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="tool-pin-btn" Classes.pinned="{Binding IsConflictsPinned}"
                                                Command="{Binding TogglePinSectionCommand}" CommandParameter="Conflicts"
                                                ToolTip.Tip="{Binding ConflictsPinTip}">
                                            <Panel>
                                                <icon:PackIconBoxIcons Kind="RegularPin" Width="14" Height="14" IsVisible="{Binding !IsConflictsPinned}"/>
                                                <icon:PackIconBoxIcons Kind="SolidPin" Width="14" Height="14" IsVisible="{Binding IsConflictsPinned}"/>
                                            </Panel>
                                        </Button>
                                    </Grid>
                                </Button>

                                <!-- 3. Pattern Fixer Option -->
                                <Button Command="{Binding SelectSectionCommand}" CommandParameter="Patterns"
                                        Background="Transparent" HorizontalAlignment="Stretch" Padding="10,8" CornerRadius="6" Cursor="Hand">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover">
                                            <Setter Property="Background" Value="{DynamicResource BgSurfaceHover}"/>
                                        </Style>
                                    </Button.Styles>
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <icon:PackIconBoxIcons Grid.Column="0" Kind="RegularPalette" Width="20" Height="20" Foreground="{DynamicResource TextMain}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc 'tools.patterns.title'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                                            <TextBlock Text="{loc:Loc 'tools.patterns.scan_patterns'}" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="tool-pin-btn" Classes.pinned="{Binding IsPatternsPinned}"
                                                Command="{Binding TogglePinSectionCommand}" CommandParameter="Patterns"
                                                ToolTip.Tip="{Binding PatternsPinTip}">
                                            <Panel>
                                                <icon:PackIconBoxIcons Kind="RegularPin" Width="14" Height="14" IsVisible="{Binding !IsPatternsPinned}"/>
                                                <icon:PackIconBoxIcons Kind="SolidPin" Width="14" Height="14" IsVisible="{Binding IsPatternsPinned}"/>
                                            </Panel>
                                        </Button>
                                    </Grid>
                                </Button>

                                <!-- 4. Collection Creator Option -->
                                <Button Command="{Binding SelectSectionCommand}" CommandParameter="Collections"
                                        Background="Transparent" HorizontalAlignment="Stretch" Padding="10,8" CornerRadius="6" Cursor="Hand">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover">
                                            <Setter Property="Background" Value="{DynamicResource BgSurfaceHover}"/>
                                        </Style>
                                    </Button.Styles>
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <icon:PackIconBoxIcons Grid.Column="0" Kind="RegularLayers" Width="20" Height="20" Foreground="{DynamicResource TextMain}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc 'tools.collections.title'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                                            <TextBlock Text="{loc:Loc 'tools.collections.new_collection'}" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="tool-pin-btn" Classes.pinned="{Binding IsCollectionsPinned}"
                                                Command="{Binding TogglePinSectionCommand}" CommandParameter="Collections"
                                                ToolTip.Tip="{Binding CollectionsPinTip}">
                                            <Panel>
                                                <icon:PackIconBoxIcons Kind="RegularPin" Width="14" Height="14" IsVisible="{Binding !IsCollectionsPinned}"/>
                                                <icon:PackIconBoxIcons Kind="SolidPin" Width="14" Height="14" IsVisible="{Binding IsCollectionsPinned}"/>
                                            </Panel>
                                        </Button>
                                    </Grid>
                                </Button>

                                <!-- 5. Mesh Report Option -->
                                <Button Command="{Binding SelectSectionCommand}" CommandParameter="Meshes"
                                        Background="Transparent" HorizontalAlignment="Stretch" Padding="10,8" CornerRadius="6" Cursor="Hand">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover">
                                            <Setter Property="Background" Value="{DynamicResource BgSurfaceHover}"/>
                                        </Style>
                                    </Button.Styles>
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <icon:PackIconBoxIcons Grid.Column="0" Kind="RegularCube" Width="20" Height="20" Foreground="{DynamicResource TextMain}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc 'tools.meshes.title'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                                            <TextBlock Text="{loc:Loc 'tools.meshes.subtitle'}" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="tool-pin-btn" Classes.pinned="{Binding IsMeshesPinned}"
                                                Command="{Binding TogglePinSectionCommand}" CommandParameter="Meshes"
                                                ToolTip.Tip="{Binding MeshesPinTip}">
                                            <Panel>
                                                <icon:PackIconBoxIcons Kind="RegularPin" Width="14" Height="14" IsVisible="{Binding !IsMeshesPinned}"/>
                                                <icon:PackIconBoxIcons Kind="SolidPin" Width="14" Height="14" IsVisible="{Binding IsMeshesPinned}"/>
                                            </Panel>
                                        </Button>
                                    </Grid>
                                </Button>

                                <!-- 6. CC Optimizer Option -->
                                <Button Command="{Binding SelectSectionCommand}" CommandParameter="Optimizer"
                                        Background="Transparent" HorizontalAlignment="Stretch" Padding="10,8" CornerRadius="6" Cursor="Hand">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover">
                                            <Setter Property="Background" Value="{DynamicResource BgSurfaceHover}"/>
                                        </Style>
                                    </Button.Styles>
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <icon:PackIconBoxIcons Grid.Column="0" Kind="RegularMagicWand" Width="20" Height="20" Foreground="{DynamicResource TextMain}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc 'optimizer.title'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                                            <TextBlock Text="{loc:Loc 'optimizer.subtitle'}" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="tool-pin-btn" Classes.pinned="{Binding IsOptimizerPinned}"
                                                Command="{Binding TogglePinSectionCommand}" CommandParameter="Optimizer"
                                                ToolTip.Tip="{Binding OptimizerPinTip}">
                                            <Panel>
                                                <icon:PackIconBoxIcons Kind="RegularPin" Width="14" Height="14" IsVisible="{Binding !IsOptimizerPinned}"/>
                                                <icon:PackIconBoxIcons Kind="SolidPin" Width="14" Height="14" IsVisible="{Binding IsOptimizerPinned}"/>
                                            </Panel>
                                        </Button>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!-- Right Side: Action & Metric Controls -->
            <!-- 1. Cache Cleaner Controls -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="16"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsCacheCleanerActive}">
                <!-- Stat Capsule -->
                <Border Background="{DynamicResource BgSurface}" CornerRadius="8" Padding="12,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'tools.cache.detected_caches'}" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding FormattedTotalCacheSize}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                <TextBlock Text="{Binding TotalCacheFilesCount, StringFormat='({0})'}" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <Separator Width="1" Height="22" Background="{DynamicResource BorderSubtle}"/>

                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'tools.cache.selected_clean'}" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding FormattedSelectedCacheSize}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{Binding SelectedCacheFilesCount, StringFormat='({0})'}" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Clean Selected Caches Action Button -->
                <Button Classes="btn-action-primary"
                        Command="{Binding CleanSelectedCachesCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icon:PackIconBoxIcons Kind="RegularTrash" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc 'tools.cache.clean_cache'}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 2. Conflict Scanner Controls -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="16"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsConflictScannerActive}">
                <!-- Stat Capsule: Packages Scanned & Detected Conflicts -->
                <Border Background="{DynamicResource BgSurface}" CornerRadius="8" Padding="12,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'tools.conflicts.packages_scanned'}" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Text="{Binding TotalPackagesScanned, StringFormat='{}{0} packages'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                        </StackPanel>

                        <Separator Width="1" Height="22" Background="{DynamicResource BorderSubtle}"/>

                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'tools.conflicts.detected_conflicts'}" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Text="{Binding TotalIssuesCount, StringFormat='{}{0} issues'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Scan Library for Conflicts Action Button -->
                <Button Classes="btn-action-primary"
                        Command="{Binding ScanConflictsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icon:PackIconBoxIcons Kind="RegularSearch" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc 'tools.conflicts.scan_for_conflicts'}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 3. Pattern Fixer Controls -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="16"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsPatternFixerActive}">
                <!-- Stat Capsule -->
                <Border Background="{DynamicResource BgSurface}" CornerRadius="8" Padding="12,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'tools.patterns.patterns_found'}" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Text="{Binding TotalPatternsFound}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                        </StackPanel>

                        <Separator Width="1" Height="22" Background="{DynamicResource BorderSubtle}"/>

                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'tools.patterns.broken_patterns'}" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Text="{Binding BrokenPatternsCount}" FontSize="14" FontWeight="Bold" Foreground="#ef4444"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="btn-action-primary"
                            Command="{Binding FixAllBrokenPatternsCommand}"
                            IsVisible="{Binding HasBrokenPatterns}"
                            IsEnabled="{Binding !IsFixingPatterns}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icon:PackIconBoxIcons Kind="RegularBandAid" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc 'tools.patterns.fix_all_broken'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="btn-action-primary"
                            Command="{Binding ScanPatternsCommand}"
                            IsVisible="{Binding !HasBrokenPatterns}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icon:PackIconBoxIcons Kind="RegularSearch" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc 'tools.patterns.scan_patterns'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- 5. Mesh Report Controls -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="16"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsMeshReportActive}">
                <Border Background="{DynamicResource BgSurface}" CornerRadius="8" Padding="12,8" VerticalAlignment="Center" IsVisible="{Binding HasScannedMeshes}">
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'tools.meshes.counted'}" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Text="{Binding TotalMeshesCounted}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                        </StackPanel>

                        <Separator Width="1" Height="22" Background="{DynamicResource BorderSubtle}"/>

                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'tools.meshes.heavy_count'}" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Text="{Binding HeavyMeshCount}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource StatusAmber}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center" IsVisible="{Binding HasHeavy}" IsEnabled="{Binding !IsScanningMeshes}">
                    <Button Classes="btn-action-sec" CornerRadius="7,0,0,7" Command="{Binding OptimizeVeryHeavyCommand}" ToolTip.Tip="{Binding OptimizeVeryHeavyText}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icon:PackIconBoxIcons Kind="RegularMagicWand" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc 'tools.meshes.open_optimizer'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="OptimizerSendButton" Classes="btn-action-sec" CornerRadius="0,7,7,0" Padding="8,7" ToolTip.Tip="{loc:Loc 'tools.meshes.optimize_more'}">
                        <icon:PackIconBoxIcons Kind="RegularChevronDown" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <Border Padding="6" MinWidth="260" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel Spacing="2">
                                        <Button Command="{Binding OptimizeVeryHeavyCommand}" Click="OnOptimizerSendClick" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" CornerRadius="6" Cursor="Hand">
                                            <TextBlock Text="{Binding OptimizeVeryHeavyText}" FontSize="12.5" Foreground="{DynamicResource TextMain}"/>
                                        </Button>
                                        <Button Command="{Binding OptimizeHeavyCommand}" Click="OnOptimizerSendClick" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" CornerRadius="6" Cursor="Hand">
                                            <TextBlock Text="{Binding OptimizeHeavyText}" FontSize="12.5" Foreground="{DynamicResource TextMain}"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <Button Classes="btn-action-primary"
                        Command="{Binding ScanMeshesCommand}"
                        IsEnabled="{Binding !IsScanningMeshes}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icon:PackIconBoxIcons Kind="RegularSearch" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc 'tools.meshes.scan'}" IsVisible="{Binding !HasScannedMeshes}" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc 'tools.meshes.rescan'}" IsVisible="{Binding HasScannedMeshes}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 6. CC Optimizer: the list being worked on, or everything optimized before -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="14,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsOptimizerActive}">
                <Button x:Name="OptimizerQueueTab" Classes="filter-btn" Classes.active="{Binding Optimizer.ShowQueue}" Command="{Binding Optimizer.ShowQueueViewCommand}">
                    <TextBlock Text="{loc:Loc 'optimizer.queue_tab'}"/>
                </Button>
                <Button x:Name="OptimizerHistoryTab" Classes="filter-btn" Classes.active="{Binding Optimizer.ShowHistory}" Command="{Binding Optimizer.ShowHistoryViewCommand}">
                    <TextBlock Text="{Binding Optimizer.HistoryTabText}"/>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="16"
                        VerticalAlignment="Center">
                <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsOptimizerActive"/>
                        <Binding Path="Optimizer.ShowQueue"/>
                    </MultiBinding>
                </StackPanel.IsVisible>
                <Border Background="{DynamicResource BgSurface}" CornerRadius="8" Padding="12,8" VerticalAlignment="Center" IsVisible="{Binding Optimizer.HasItems}">
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'optimizer.items'}" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Text="{Binding Optimizer.Items.Count}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                        </StackPanel>
                        <Separator Width="1" Height="22" Background="{DynamicResource BorderSubtle}"/>
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'optimizer.to_save'}" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Text="{Binding Optimizer.SaveCount}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <health:CcOptimizerActionsView DataContext="{Binding Optimizer}"/>
            </StackPanel>

            <!-- 4. Collection Creator Controls -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="16"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsCollectionCreatorActive}">
                <!-- Stat Capsule -->
                <Border Background="{DynamicResource BgSurface}" CornerRadius="8" Padding="12,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'tools.collections.collections'}" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Text="{Binding TotalCollectionsCount}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                        </StackPanel>

                        <Separator Width="1" Height="22" Background="{DynamicResource BorderSubtle}"/>

                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'tools.collections.items_in_collection'}" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Text="{Binding TotalCollectionItemsCount}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="btn-action-sec"
                            Command="{Binding OpenCollectionsFolderCommand}"
                            ToolTip.Tip="{loc:Loc 'tools.collections.open_folder'}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icon:PackIconBoxIcons Kind="RegularFolder" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc 'common.folder'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="btn-action-primary"
                            Command="{Binding RequestNewCollectionCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icon:PackIconBoxIcons Kind="RegularPlus" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc 'tools.collections.new_collection'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
