<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PlumbobForge.Desktop.ViewModels"
             xmlns:icon="using:PlumbobForge.Desktop.Controls.Icons"
             xmlns:loc="using:PlumbobForge.Desktop.MarkupExtensions"
             xmlns:mp="using:PlumbobForge.Desktop.Controls.MeshPreview"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
             x:Class="PlumbobForge.Desktop.Views.Health.MeshReportView"
             x:DataType="vm:HealthViewModel">

    <Grid RowDefinitions="Auto, *" HorizontalAlignment="Stretch">

        <!-- Row 0: filters and search -->
        <Grid Grid.Row="0" RowDefinitions="Auto, Auto" Margin="0,0,0,16" IsVisible="{Binding HasScannedMeshes}">
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                <WrapPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- Scope from a library menu (Open In > Mesh Report): what is shown, and a way back to everything -->
                    <Button Classes="filter-btn active" Command="{Binding ClearMeshScopeCommand}" IsVisible="{Binding HasMeshScope}"
                            Margin="0,0,8,0" ToolTip.Tip="{loc:Loc 'tools.meshes.scope_clear_tip'}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MeshScopeLabel}" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <icon:PackIconBoxIcons Kind="RegularX" Width="11" Height="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="20" Background="{DynamicResource BorderSubtle}" Margin="4,0,12,0" VerticalAlignment="Center" IsVisible="{Binding HasMeshScope}"/>
                    <Button Classes="filter-btn" Classes.active="{Binding IsMeshFilterHeavy}" Command="{Binding SetMeshWeightFilterCommand}" CommandParameter="Heavy" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <icon:PackIconBoxIcons Kind="RegularTachometer" Width="13" Height="13" Foreground="{DynamicResource StatusAmber}" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc 'tools.meshes.filter_heavy'}" VerticalAlignment="Center"/>
                            <Border Classes="weight-chip heavy">
                                <TextBlock Text="{Binding HeavyMeshCount}"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Classes="filter-btn" Classes.active="{Binding IsMeshFilterAll}" Command="{Binding SetMeshWeightFilterCommand}" CommandParameter="All" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'tools.meshes.filter_all'}" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotalMeshesCounted}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Kind: only worth showing when the library has both -->
                    <Border Width="1" Height="20" Background="{DynamicResource BorderSubtle}" Margin="4,0,12,0" VerticalAlignment="Center" IsVisible="{Binding HasMeshKinds}"/>
                    <Button Classes="filter-btn" Classes.active="{Binding IsMeshKindAll}" Command="{Binding SetMeshKindFilterCommand}" CommandParameter="All" Margin="0,0,8,0" IsVisible="{Binding HasMeshKinds}"
                            Content="{loc:Loc 'look_inside.filter_all'}"/>
                    <Button Classes="filter-btn" Classes.active="{Binding IsMeshKindCas}" Command="{Binding SetMeshKindFilterCommand}" CommandParameter="Cas" Margin="0,0,8,0" IsVisible="{Binding HasMeshKinds}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icon:PackIconBoxIcons Kind="RegularHanger" Width="13" Height="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc 'look_inside.filter_cas'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="filter-btn" Classes.active="{Binding IsMeshKindBuildBuy}" Command="{Binding SetMeshKindFilterCommand}" CommandParameter="BuildBuy" IsVisible="{Binding HasMeshKinds}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icon:PackIconBoxIcons Kind="RegularChair" Width="13" Height="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc 'look_inside.filter_build_buy'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <TextBox Grid.Column="2" Classes="capsule-search" Text="{Binding MeshSearchQuery, Mode=TwoWay}" PlaceholderText="{loc:Loc 'tools.meshes.search_watermark'}">
                    <TextBox.InnerLeftContent>
                        <icon:PackIconBoxIcons Kind="RegularSearch" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" Margin="10,0,4,0" VerticalAlignment="Center"/>
                    </TextBox.InnerLeftContent>
                    <TextBox.InnerRightContent>
                        <Button Command="{Binding ClearMeshSearchCommand}" Background="Transparent" BorderThickness="0" Padding="4" Margin="0,0,4,0" Cursor="Hand"
                                IsVisible="{Binding HasMeshSearchQuery}" ToolTip.Tip="{loc:Loc 'common.clear_search'}">
                            <icon:PackIconBoxIcons Kind="RegularX" Width="12" Height="12" Foreground="{DynamicResource TextMuted}"/>
                        </Button>
                    </TextBox.InnerRightContent>
                </TextBox>
            </Grid>

            <!-- What the numbers mean, and what could not be counted -->
            <StackPanel Grid.Row="1" Spacing="4" Margin="2,12,0,0">
                <TextBlock Text="{loc:Loc 'tools.meshes.explainer'}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding MeshNotes}" IsVisible="{Binding HasMeshNotes}" FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- Row 1: content -->
        <Grid Grid.Row="1">
            <!-- Scanning -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" IsVisible="{Binding IsScanningMeshes}" Margin="0,40">
                <ProgressBar Minimum="0" Maximum="{Binding MeshScanTotal}" Value="{Binding MeshScanDone}" Width="280" Height="4" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="{loc:Loc 'tools.meshes.scanning'}" FontSize="13" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding MeshScanProgressText}" FontSize="11.5" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
            </StackPanel>

            <Grid IsVisible="{Binding !IsScanningMeshes}">
                <!-- Not counted yet -->
                <Border Classes="settings-card" Padding="32" IsVisible="{Binding !HasScannedMeshes}" VerticalAlignment="Top">
                    <StackPanel HorizontalAlignment="Center" Spacing="12" Margin="20">
                        <Border Background="{DynamicResource AccentBadgeBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="24" Width="48" Height="48" HorizontalAlignment="Center">
                            <icon:PackIconBoxIcons Kind="RegularCube" Width="24" Height="24" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{loc:Loc 'tools.meshes.intro_title'}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc 'tools.meshes.intro_desc'}" FontSize="13" Foreground="{DynamicResource TextMuted}" MaxWidth="560" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Nothing to show -->
                <Border Classes="settings-card" Padding="32,24" IsVisible="{Binding ShowMeshEmpty}" VerticalAlignment="Top" Margin="0,8">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource BgSurface}" HorizontalAlignment="Center">
                            <icon:PackIconBoxIcons Kind="RegularCube" Width="26" Height="26" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding MeshEmptyTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding MeshEmptyText}" FontSize="12.5" Foreground="{DynamicResource TextMuted}" MaxWidth="560" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Narrow: the cards, one under another -->
                <Panel IsVisible="{Binding IsNarrowLayout}">
                <ListBox Classes="card-list" ItemsSource="{Binding FilteredMeshRows}" IsVisible="{Binding ShowMeshList}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:MeshReportRowViewModel">
                            <Border Classes="settings-card" Margin="0,0,0,10" Padding="16,14">
                                <Grid ColumnDefinitions="Auto, *, Auto, Auto" VerticalAlignment="Center">
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                            VerticalAlignment="Center" Margin="0,0,14,0">
                                        <Panel>
                                            <Panel IsVisible="{Binding ShowKindIcon}">
                                                <icon:PackIconBoxIcons Kind="RegularHanger" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsCas}"/>
                                                <icon:PackIconBoxIcons Kind="RegularChair" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsBuildBuy}"/>
                                            </Panel>
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding !ShowKindIcon}"/>
                                        </Panel>
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMain}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <Border Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" IsVisible="{Binding IsOff}">
                                                <TextBlock Text="{loc:Loc 'look_inside.off_tag'}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource BorderSubtle}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding FileName}" FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DetailText}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>

                                    <!-- Size -->
                                    <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center" Margin="16,0" MinWidth="96">
                                        <TextBlock Text="{Binding TrianglesText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Right"/>
                                        <Border Classes="weight-chip" Classes.light="{Binding IsLight}" Classes.medium="{Binding IsMedium}" Classes.heavy="{Binding IsHeavy}" Classes.veryheavy="{Binding IsVeryHeavy}" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding WeightText}"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Classes="btn-action-sec" Command="{Binding LookInsideCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <icon:PackIconBoxIcons Kind="RegularSearch" Width="13" Height="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{loc:Loc 'look_inside.title'}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="btn-action-sec" Command="{Binding OptimizeCommand}" ToolTip.Tip="{loc:Loc 'optimizer.open_tip'}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <icon:PackIconBoxIcons Kind="RegularMagicWand" Width="13" Height="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{loc:Loc 'optimizer.open'}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="btn-action-sec" Command="{Binding ShowInLibraryCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <icon:PackIconBoxIcons Kind="RegularFolderOpen" Width="13" Height="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{loc:Loc 'tools.conflicts.view_in_library'}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </Panel>

                <!-- Wide: a compact list, and the selected item with a 3D preview beside it -->
                <Grid x:Name="MeshWideLayout" ColumnDefinitions="420, 16, *" IsVisible="{Binding IsWideLayout}">
                    <Border Classes="settings-card" Padding="0" IsVisible="{Binding ShowMeshList}">
                        <ListBox x:Name="MeshPickList" Classes="pick-list" ItemsSource="{Binding FilteredMeshRows}" SelectedItem="{Binding SelectedMeshRow, Mode=TwoWay}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:MeshReportRowViewModel">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <Border Width="34" Height="34" CornerRadius="7" ClipToBounds="True" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                                VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Panel>
                                                <Panel IsVisible="{Binding ShowKindIcon}">
                                                    <icon:PackIconBoxIcons Kind="RegularHanger" Width="15" Height="15" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsCas}"/>
                                                    <icon:PackIconBoxIcons Kind="RegularChair" Width="15" Height="15" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsBuildBuy}"/>
                                                </Panel>
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding !ShowKindIcon}"/>
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                                                <TextBlock Text="{loc:Loc 'look_inside.off_tag'}" FontSize="10.5" Foreground="{DynamicResource TextMuted}" IsVisible="{Binding IsOff}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TrianglesText}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Right"/>
                                            <Border Classes="weight-chip" Classes.light="{Binding IsLight}" Classes.medium="{Binding IsMedium}" Classes.heavy="{Binding IsHeavy}" Classes.veryheavy="{Binding IsVeryHeavy}" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding WeightText}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- The selected item: a 3D preview, its numbers, and what to do with it -->
                    <Border x:Name="MeshDetails" Grid.Column="2" Classes="settings-card" Padding="0" ClipToBounds="True" IsVisible="{Binding HasSelectedMeshRow}">
                        <Grid RowDefinitions="*, Auto">
                            <Panel MinHeight="280" Background="{DynamicResource BgSurface}">
                                <mp:MeshPreviewControl Meshes="{Binding MeshPreview.PreviewMeshes, FallbackValue={x:Null}}" Texture="{Binding MeshPreview.PreviewTexture, FallbackValue={x:Null}}"
                                                       ShowWireframe="{Binding MeshPreview.ShowWireframe, FallbackValue=False}"
                                                       Background="{DynamicResource BgSurface}" IsVisible="{Binding MeshPreview.ShowViewer, FallbackValue=False}"/>
                                <TextBlock Text="{loc:Loc 'optimizer.controls_hint'}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="14,10" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                           IsHitTestVisible="False" IsVisible="{Binding MeshPreview.ShowViewer, FallbackValue=False}"/>
                                <ProgressBar IsIndeterminate="True" Width="160" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                             IsVisible="{Binding MeshPreview.IsLoading, FallbackValue=True}"/>
                                <StackPanel IsVisible="{Binding MeshPreview.HasError, FallbackValue=False}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="420" Margin="24">
                                    <icon:PackIconBoxIcons Kind="RegularCube" Width="28" Height="28" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding MeshPreview.ErrorMessage, FallbackValue={x:Null}}" FontSize="12.5" Foreground="{DynamicResource TextMain}" TextWrapping="Wrap" TextAlignment="Center"/>
                                </StackPanel>
                            </Panel>

                            <StackPanel Grid.Row="1" Spacing="12" Margin="18,14,18,16">
                                <StackPanel Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding SelectedMeshRow.Title, FallbackValue={x:Null}}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextMain}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <Border Classes="weight-chip" Classes.light="{Binding SelectedMeshRow.IsLight, FallbackValue=False}" Classes.medium="{Binding SelectedMeshRow.IsMedium, FallbackValue=False}"
                                                Classes.heavy="{Binding SelectedMeshRow.IsHeavy, FallbackValue=False}" Classes.veryheavy="{Binding SelectedMeshRow.IsVeryHeavy, FallbackValue=False}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedMeshRow.WeightText, FallbackValue={x:Null}}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding SelectedMeshRow.Subtitle, FallbackValue={x:Null}}" FontSize="11.5" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource BorderSubtle}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedMeshRow.FileName, FallbackValue={x:Null}}" FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid ColumnDefinitions="*, 10, *, 10, *">
                                    <Border Background="{DynamicResource BgSurface}" CornerRadius="8" Padding="12,8">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{loc:Loc 'tools.meshes.stat_triangles'}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Text="{Binding SelectedMeshRow.TrianglesText, FallbackValue={x:Null}}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="{DynamicResource BgSurface}" CornerRadius="8" Padding="12,8">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{loc:Loc 'tools.meshes.stat_vertices'}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Text="{Binding SelectedMeshRow.VerticesText, FallbackValue={x:Null}}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Background="{DynamicResource BgSurface}" CornerRadius="8" Padding="12,8">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{loc:Loc 'tools.meshes.stat_levels'}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Text="{Binding SelectedMeshRow.LevelsText, FallbackValue={x:Null}}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="MeshDetailsOptimize" Classes="btn-action-primary" Command="{Binding SelectedMeshRow.OptimizeCommand, FallbackValue={x:Null}}" ToolTip.Tip="{loc:Loc 'optimizer.open_tip'}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <icon:PackIconBoxIcons Kind="RegularMagicWand" Width="13" Height="13" Foreground="White" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:Loc 'optimizer.open'}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="btn-action-sec" Command="{Binding SelectedMeshRow.LookInsideCommand, FallbackValue={x:Null}}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <icon:PackIconBoxIcons Kind="RegularSearch" Width="13" Height="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:Loc 'look_inside.title'}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="btn-action-sec" Command="{Binding SelectedMeshRow.ShowInLibraryCommand, FallbackValue={x:Null}}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <icon:PackIconBoxIcons Kind="RegularFolderOpen" Width="13" Height="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:Loc 'tools.conflicts.view_in_library'}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
