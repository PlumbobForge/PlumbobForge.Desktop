<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PlumbobForge.Desktop.ViewModels"
             xmlns:icon="using:IconPacks.Avalonia.BoxIcons"
             xmlns:loc="using:PlumbobForge.Desktop.MarkupExtensions"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
             x:Class="PlumbobForge.Desktop.Views.Health.PatternFixerView"
             x:DataType="vm:HealthViewModel">

    <Grid RowDefinitions="Auto, *" HorizontalAlignment="Stretch">

        <!-- Row 0: Filter Pills, Search & Bulk Actions Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center" Margin="0,0,0,16" IsVisible="{Binding HasScannedPatterns}">
            <!-- Filter Pills with embedded counts -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <!-- Broken Patterns Only (Default) -->
                <Button Classes="filter-btn"
                        Classes.active="{Binding IsPatternFilterBroken}"
                        Command="{Binding SetPatternFilterCommand}"
                        CommandParameter="Broken">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <icon:PackIconBoxIcons Kind="RegularBadgeExclamation" Width="13" Height="13" Foreground="#ef4444" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc 'tools.patterns.broken'}" VerticalAlignment="Center"/>
                        <Border Background="#331518" BorderBrush="#ef4444" BorderThickness="1" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding BrokenPatternsCount}" FontSize="11" FontWeight="Bold" Foreground="#ef4444"/>
                        </Border>
                    </StackPanel>
                </Button>

                <!-- All Patterns -->
                <Button Classes="filter-btn"
                        Classes.active="{Binding IsPatternFilterAll}"
                        Command="{Binding SetPatternFilterCommand}"
                        CommandParameter="All">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc 'tools.patterns.all'}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalPatternsFound}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                        </Border>
                    </StackPanel>
                </Button>

                <!-- Fixed / Clean Patterns -->
                <Button Classes="filter-btn"
                        Classes.active="{Binding IsPatternFilterFixed}"
                        Command="{Binding SetPatternFilterCommand}"
                        CommandParameter="Fixed">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <icon:PackIconBoxIcons Kind="RegularCheckCircle" Width="13" Height="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc 'tools.patterns.fixed'}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FixedPatternsCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Search Input -->
            <TextBox Grid.Column="2"
                     Classes="capsule-search"
                     Text="{Binding PatternSearchQuery, Mode=TwoWay}"
                     Watermark="{loc:Loc 'tools.patterns.search_watermark'}">
                <TextBox.InnerLeftContent>
                    <icon:PackIconBoxIcons Kind="RegularSearch" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" Margin="10,0,4,0" VerticalAlignment="Center"/>
                </TextBox.InnerLeftContent>
                <TextBox.InnerRightContent>
                    <Button Command="{Binding ClearPatternSearchCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="4"
                            Margin="0,0,4,0"
                            Cursor="Hand"
                            IsVisible="{Binding HasPatternSearchQuery}"
                            ToolTip.Tip="{loc:Loc 'common.clear_search'}">
                        <icon:PackIconBoxIcons Kind="RegularX" Width="12" Height="12" Foreground="{DynamicResource TextMuted}"/>
                    </Button>
                </TextBox.InnerRightContent>
            </TextBox>
        </Grid>

        <!-- Row 1: Content Area -->
        <Grid Grid.Row="1">
            <!-- Loading Indicator -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" IsVisible="{Binding IsScanningPatterns}" Margin="0,40">
                <ProgressBar IsIndeterminate="True" Width="240" Height="4" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="{loc:Loc 'tools.patterns.scanning'}"
                           FontSize="13"
                           Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Main Patterns Content Area -->
            <Grid RowDefinitions="Auto, *" IsVisible="{Binding !IsScanningPatterns}">
                <!-- Bulk Selection & Action Header (when broken patterns exist) -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="4,0,4,8" IsVisible="{Binding HasBrokenPatterns}">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Background="Transparent" Padding="0" Cursor="Hand" Command="{Binding SelectAllPatternsCommand}">
                            <TextBlock Text="{loc:Loc 'tools.patterns.select_all_broken'}" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                        </Button>
                        <TextBlock Text="•" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                        <Button Background="Transparent" Padding="0" Cursor="Hand" Command="{Binding DeselectAllPatternsCommand}">
                            <TextBlock Text="{loc:Loc 'common.deselect_all'}" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                        </Button>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Classes="btn-action-primary"
                            Command="{Binding FixSelectedPatternsCommand}"
                            IsEnabled="{Binding !IsFixingPatterns}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icon:PackIconBoxIcons Kind="RegularBandAid" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc 'tools.patterns.fix_selected'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Clean State / No Issues Found -->
                <Border Grid.Row="1" Classes="settings-card" Padding="32,24" IsVisible="{Binding IsNoPatternIssues}" VerticalAlignment="Top" Margin="0,8">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource BgSurface}" HorizontalAlignment="Center">
                            <icon:PackIconBoxIcons Kind="RegularCheckCircle" Width="26" Height="26" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{loc:Loc 'tools.patterns.healthy_title'}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextMain}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc 'tools.patterns.healthy_desc'}"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextMuted}"
                                   MaxWidth="560"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Pattern Cards Virtualized ListBox -->
                <ListBox Grid.Row="1"
                         Classes="card-list"
                         ItemsSource="{Binding FilteredPatternIssues}"
                         IsVisible="{Binding !IsNoPatternIssues}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PatternIssueItemViewModel}">
                            <Border Classes="settings-card" Margin="0,0,0,10" Padding="16,14">
                                <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                                    <!-- Left: Selection Checkbox & Pattern Icon -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  IsVisible="{Binding IsBroken}"
                                                  VerticalAlignment="Center"
                                                  Margin="0"/>

                                        <Border Width="36" Height="36"
                                                CornerRadius="8"
                                                Background="{DynamicResource BgSurface}"
                                                BorderBrush="{DynamicResource BorderSubtle}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <icon:PackIconBoxIcons Kind="RegularPalette"
                                                                   Width="18" Height="18"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Middle: Pattern Info, Filename, Set, and Issue Details -->
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <!-- Pattern Name and Category Badge -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PatternName}"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextMain}"
                                                       VerticalAlignment="Center"/>

                                            <Border Background="{DynamicResource BgSurface}"
                                                    BorderBrush="{DynamicResource BorderSubtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,1"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextMuted}"/>
                                            </Border>

                                            <!-- Status Pill -->
                                            <Border Background="#331518"
                                                    BorderBrush="#ef4444"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,1"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding IsBroken}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <icon:PackIconBoxIcons Kind="RegularBadgeExclamation" Width="11" Height="11" Foreground="#ef4444" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding CorruptedKeyCount, StringFormat='{}Causes CaST Freeze ({0} bad keys)'}"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="#ef4444"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="{DynamicResource BgSurface}"
                                                    BorderBrush="{DynamicResource AccentBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,1"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding IsFixed}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <icon:PackIconBoxIcons Kind="RegularCheck" Width="11" Height="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{loc:Loc 'tools.patterns.fixed_badge'}"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Filename and Set location -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource BorderSubtle}" VerticalAlignment="Center"/>

                                            <TextBlock Text="{Binding SetName, StringFormat='{}Set: {0}'}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Sample Broken String (when broken) -->
                                        <TextBlock Text="{Binding BrokenKeysSampleText, StringFormat='{}Bug detail: {0}'}"
                                                   FontSize="10.5"
                                                   Foreground="#f87171"
                                                   IsVisible="{Binding IsBroken}"
                                                   FontFamily="Consolas, monospace"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Right: Action Buttons -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <!-- Fix Single Pattern Button -->
                                        <Button Classes="btn-action-primary"
                                                Padding="10,6"
                                                Command="{Binding FixCommand}"
                                                IsVisible="{Binding IsBroken}"
                                                IsEnabled="{Binding !IsFixing}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <icon:PackIconBoxIcons Kind="RegularBandAid" Width="13" Height="13" Foreground="White" VerticalAlignment="Center"/>
                                                <TextBlock Text="{loc:Loc 'tools.patterns.fix_pattern'}" FontSize="11.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Jump to Library Item -->
                                        <Button Background="{DynamicResource BgSurface}"
                                                BorderBrush="{DynamicResource BorderSubtle}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,6"
                                                Cursor="Hand"
                                                Command="{Binding NavigateToItemCommand}"
                                                ToolTip.Tip="{loc:Loc 'tools.conflicts.view_in_library'}">
                                            <icon:PackIconBoxIcons Kind="RegularFolderOpen" Width="13" Height="13" Foreground="{DynamicResource TextMuted}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
