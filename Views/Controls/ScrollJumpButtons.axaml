<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icon="using:PlumbobForge.Desktop.Controls.Icons"
             xmlns:loc="using:PlumbobForge.Desktop.MarkupExtensions"
             x:Class="PlumbobForge.Desktop.Views.Controls.ScrollJumpButtons"
             HorizontalAlignment="Right"
             VerticalAlignment="Bottom"
             Margin="0,0,20,20">

    <UserControl.Styles>
        <!-- Each button sits in its own capsule like the library's top bar; the capsule fades with its shadow -->
        <Style Selector="Border.jump-slot">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="{DynamicResource CapsuleBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CapsuleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BoxShadow" Value="0 4 16 #20000000, 0 1 4 #10000000"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.jump-slot.shown">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
        <Style Selector="Button.jump-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.jump-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgCardAlt}"/>
        </Style>
        <Style Selector="Button.jump-btn icon|PackIconBoxIcons">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>
        <Style Selector="Button.jump-btn:pointerover icon|PackIconBoxIcons">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        </Style>
    </UserControl.Styles>

    <!-- Fixed slots: when Bottom fades out at the end of the list, Top stays where it was -->
    <Grid RowDefinitions="Auto, 8, Auto">
        <Border Grid.Row="0" x:Name="TopSlot" Classes="jump-slot">
            <Button x:Name="TopButton" Classes="jump-btn" Click="OnTopClick" ToolTip.Tip="{loc:Loc 'common.scroll_top_tip'}">
                <icon:PackIconBoxIcons Kind="RegularArrowUpStroke" Width="16" Height="16"/>
            </Button>
        </Border>
        <Border Grid.Row="2" x:Name="BottomSlot" Classes="jump-slot">
            <Button x:Name="BottomButton" Classes="jump-btn" Click="OnBottomClick" ToolTip.Tip="{loc:Loc 'common.scroll_bottom_tip'}">
                <icon:PackIconBoxIcons Kind="RegularArrowDownStroke" Width="16" Height="16"/>
            </Button>
        </Border>
    </Grid>
</UserControl>
