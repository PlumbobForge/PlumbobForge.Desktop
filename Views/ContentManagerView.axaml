<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlumbobForge.Desktop.ViewModels"
             xmlns:cm="using:PlumbobForge.Desktop.Views.ContentManager"
             xmlns:ctrl="using:PlumbobForge.Desktop.Controls"
             xmlns:icon="using:IconPacks.Avalonia.BoxIcons"
             xmlns:loc="using:PlumbobForge.Desktop.MarkupExtensions"
             x:Class="PlumbobForge.Desktop.Views.ContentManagerView"
             x:DataType="vm:ContentManagerViewModel"
             DragDrop.AllowDrop="True">

    <UserControl.Styles>


        <!-- Spinner Rotating Animation -->
        <Style Selector="icon|PackIconBoxIcons.spinner">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource BgDark}">
        <Grid ColumnDefinitions="Auto, *, Auto">
            <!-- Left Floating Sidebar: Sets Tree Component -->
            <cm:SetsSidebarView Grid.Column="0"/>

            <!-- Main Items Center Area -->
            <Grid Grid.Column="1">
                <!-- Items Virtualized Grid Container (Rubberband Drag Select, Middle-Click Autoscroll & ContextMenu) -->
                <Grid x:Name="ItemsGridContainer" Background="Transparent">
                    <Grid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{loc:Loc 'library.toggle_enable_selected'}" Command="{Binding ToggleEnableSelectedCommand}" IsEnabled="{Binding HasSelectedItems}">
                                <MenuItem.Icon>
                                    <icon:PackIconBoxIcons Kind="RegularToggleLeft" Width="16" Height="16"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{loc:Loc 'library.retag_selected'}" Command="{Binding EditTagsSelectedCommand}" IsEnabled="{Binding HasSelectedItems}">
                                <MenuItem.Icon>
                                    <icon:PackIconBoxIcons Kind="RegularTag" Width="16" Height="16"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="{Binding DeleteItemsMenuHeader}" Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding HasSelectedItems}">
                                <MenuItem.Icon>
                                    <icon:PackIconBoxIcons Kind="RegularTrash" Width="16" Height="16" Foreground="#ef4444"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Grid.ContextMenu>

                    <!-- Scrollable Items Area with Top Padding for Floating Buttons -->
                    <!-- Grid View (Multi-column uniform card rows) -->
                    <ListBox x:Name="ItemsListBox"
                             ItemsSource="{Binding FilteredRows}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="8, 64, 8, 16"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             IsVisible="{Binding !IsCompactListView}"
                             SizeChanged="OnItemsListBoxSizeChanged">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ItemRowViewModel}">
                                <cm:ItemRowView />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Compact List View (Single-column high-density item rows) -->
                    <ListBox x:Name="ItemsCompactListBox"
                             ItemsSource="{Binding FilteredItems}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="8, 64, 8, 16"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             IsVisible="{Binding IsCompactListView}">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ItemViewModel}">
                                <cm:ItemCompactRowView />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Top Gradient Fade Overlay (smooth fade for scrolling items behind floating buttons) -->
                    <!-- Top Gradient Fade Overlay (smooth fade for scrolling items behind floating buttons) -->
                    <Border Height="72" VerticalAlignment="Top" IsHitTestVisible="False" Background="{DynamicResource TopFadeGradientBrush}"/>

                    <!-- Floating Top Toolbar Component -->
                    <cm:ContentHeaderBarView Margin="14, 14, 14, 0" VerticalAlignment="Top"/>

                    <!-- Rubberband & Autoscroll Canvas -->
                    <Canvas x:Name="RubberbandCanvas" IsHitTestVisible="False">
                        <Border x:Name="RubberbandBox" Background="{DynamicResource AccentRubberbandBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="4" IsVisible="False"/>
                        <!-- Autoscroll Anchor Visual -->
                        <Border x:Name="AutoscrollAnchor" Width="28" Height="28" Background="{DynamicResource BgDark}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="14" IsVisible="False" IsHitTestVisible="False">
                            <icon:PackIconBoxIcons Kind="RegularRowResize" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Canvas>

                    <!-- Loading Indicator Overlay (Fades out when packages finish indexing) -->
                    <Border Background="{DynamicResource BgDark}" IsVisible="{Binding IsLoading}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                            <!-- Glowing Spinner Container -->
                            <Border Width="56" Height="56" Background="{DynamicResource AccentBadgeBgBrush}" CornerRadius="28" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5">
                                <icon:PackIconBoxIcons Classes="spinner" Kind="RegularRefreshCw" Width="28" Height="28" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <TextBlock Text="{loc:Loc 'library.loading_items'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc 'library.indexing_packages'}" FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Right Floating Sidebar: Filters Component -->
            <cm:FiltersSidebarView Grid.Column="2"/>
        </Grid>

        <!-- Drop Files Visual Overlay -->
        <Border Background="#e00f172a" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3" CornerRadius="12" Margin="24"
                IsVisible="{Binding IsDragOver}" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <icon:PackIconBoxIcons Kind="RegularArrowToBottomStroke" Width="64" Height="64" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="{loc:Loc 'library.drop_title'}" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="{loc:Loc 'library.drop_subtitle'}" FontSize="13" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
